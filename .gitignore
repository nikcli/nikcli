.opencode/references/effect-smol/
.scratch/

.cargo-ade/
packages/ade/dist/
packages/ade/src-tauri/target/
.tmp-build/
.ade-webview/
.ade-appdata/
.ade-trees/
# Worktree annidata di una sessione aperta: Windows non lascia spostarla finche
# la sessione ci lavora dentro, e senza questa riga un git clean -fd qui la
# cancellerebbe con dentro il lavoro non committato. La regola resta: le
# worktree si creano A FIANCO del progetto, mai dentro; questa riga copre il
# caso finche quella di layout non viene spostata.
/layout/
# ATTENZIONE: una cartella ignorata NON e protetta da git clean -fdx o -fdX, che
# cancellano proprio cio che e ignorato. Finche /layout/ e .ade-trees/ stanno
# dentro questo albero, qui non si lancia clean con la x.

# Local wrangler state (D1/KV/R2 emulation), written by `wrangler dev` and
# `d1 migrations apply --local`. Machine-local, never committed.
.wrangler/
packages/ade/.lavish/

# Caches, logs and test output
.ruff_cache/
__pycache__/
*.pyc
*.log
coverage/
.nyc_output/
playwright-report/
test-results/

# Signing material — never commit
*.pem
*.p12
*.mobileprovision

# Claude Code local state (team-wide, not just .git/info/exclude)
.claude/RESUME.md
.claude/worktrees/
.claude/settings.local.json

# nikcli devhub scratch (junit reports, perf probes, playground scripts)
.devhub/
packages/devhub/src-tauri/target/
packages/devhub/src-tauri/gen/
packages/devhub/dist/
