{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nikcli-identity",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // A deploy replaces every Custom Domain on this Worker with this list. The
  // nikcli.store host stays: installs signed in before the move refresh
  // against it, and passkeys created there are bound to it (LEGACY_ISSUER_HOSTS
  // in src/constants.ts).
  "routes": [
    {
      "pattern": "auth.nikcli-ai.dev",
      "custom_domain": true,
    },
    {
      "pattern": "auth.nikcli.store",
      "custom_domain": true,
    },
  ],
  "vars": {
    "ISSUER": "https://auth.nikcli-ai.dev",
    "AUDIENCE": "nikcli-api",
    "EMAIL_SENDER": "auth@nikcli-ai.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nikcli-identity",
      "migrations_dir": "migrations",
      "database_id": "843749a1-d0da-4b7d-bb90-c3ab1036a554",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "683569840fa64e8eb91c99e757bdb832",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "env": {
    "staging": {
      "name": "nikcli-identity-staging",
      "routes": [
        {
          "pattern": "dev.auth.nikcli-ai.dev",
          "custom_domain": true,
        },
        {
          "pattern": "dev.auth.nikcli.store",
          "custom_domain": true,
        },
      ],
      "vars": {
        "ISSUER": "https://dev.auth.nikcli-ai.dev",
        "AUDIENCE": "nikcli-api",
        "EMAIL_SENDER": "auth@nikcli-ai.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nikcli-identity-staging",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "STATE",
        },
      ],
      "send_email": [
        {
          "name": "EMAIL",
        },
      ],
    },
  },
}
