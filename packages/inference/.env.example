# ---- Server ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Local vLLM fallback (optional) ----
VLLM_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=local-dev-key

# ---- Managed providers (add as many as you have keys for) ----
# Cheapest open-weight serving (sorted alphabetically; the router auto-picks the cheapest healthy one per model).
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
HYPERBOLIC_API_KEY=
NEBIUS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_REFERRER=https://nikcli-ai.dev
OPENROUTER_APP_NAME=nikcli-inference
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=

# ---- Cache + rate limiting (Upstash REST; both required to enable L2) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tune the in-memory L1 cache (also used as L2 read-through buffer):
INFERENCE_CACHE_MAX=5000
INFERENCE_CACHE_TTL=86400

# Allow routing through speculative/unverified upstream routes (default false).
ALLOW_ESTIMATED_ROUTES=false

# Provider name to prefer for ALL requests by default (e.g. "openrouter"). Per-request nikcli.preferProvider overrides.
DEFAULT_PREFER_PROVIDER=

# ---- Billing (optional) ----
STRIPE_SECRET_KEY=
