---
import Dashboard from "../../layouts/Dashboard.astro"
import { getCurrentUser } from "../../lib/auth"
import DeleteAccountSection from "../../components/DeleteAccountSection"

const user = await getCurrentUser(Astro as any).catch(() => null)
if (!user) return Astro.redirect("/sign-in")
---

<Dashboard active="settings" title="Settings · nikcli Inference">
  <div class="app-page">
    <div class="app-header">
      <div>
        <p class="app-kicker">Account</p>
        <h1 class="app-title">Settings</h1>
        <p class="app-subtitle">Manage profile details, dashboard security, billing access, and account deletion.</p>
      </div>
    </div>

    <section class="app-panel app-panel-pad">
      <p class="app-kicker">Profile</p>
      <h2 class="mt-2 font-display text-xl font-semibold text-terminal-text">Account details</h2>
      <dl class="mt-4 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
        <div>
          <dt class="app-label">Email</dt>
          <dd class="mt-1 text-terminal-text">{user.email}</dd>
        </div>
        <div>
          <dt class="app-label">Name</dt>
          <dd class="mt-1 text-terminal-text">{user.name ?? "—"}</dd>
        </div>
        <div>
          <dt class="app-label">Plan</dt>
          <dd class="mt-1">
            <span class="inline-flex items-center rounded-md bg-terminal-accent/10 px-2.5 py-1 text-xs font-semibold capitalize text-terminal-accent">
              {user.plan}
            </span>
          </dd>
        </div>
        <div>
          <dt class="app-label">User ID</dt>
          <dd class="mt-1 break-all font-mono text-xs text-terminal-muted">{user.id}</dd>
        </div>
      </dl>
    </section>

    <section class="app-panel app-panel-pad">
      <p class="app-kicker">Security</p>
      <h2 class="mt-2 font-display text-xl font-semibold text-terminal-text">Sign-in</h2>
      <p class="mt-3 text-sm leading-6 text-terminal-muted">
        This dashboard uses your NikCLI identity (GitHub or email verification code) — there is no password to manage.
        Sign-in and session security are handled by
        <a href="https://auth.nikcli-ai.dev" class="font-medium text-terminal-accent hover:underline">auth.nikcli-ai.dev</a>.
      </p>
    </section>

    <section class="app-panel app-panel-pad">
      <p class="app-kicker">Plan</p>
      <h2 class="mt-2 font-display text-xl font-semibold text-terminal-text">Billing</h2>
      <div class="mt-4 space-y-4">
        {user.plan === "free" && (
          <div class="rounded-[var(--radius-md)] border border-terminal-accent/30 bg-terminal-accent/5 p-4">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-5 h-5 text-terminal-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <h3 class="font-semibold text-terminal-text">Upgrade to Enterprise</h3>
            </div>
            <p class="text-sm text-terminal-muted mb-3">Get higher rate limits, dedicated support, and custom pricing.</p>
            <a href="mailto:enterprise@nikcli-ai.dev?subject=Enterprise Plan Inquiry" class="app-button-primary w-fit">
              Contact Sales
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        )}
        <p class="text-sm text-terminal-muted">
          Your current plan is <span class="font-semibold capitalize text-terminal-text">{user.plan}</span>. Usage is tracked per request in the dashboard.
        </p>
      </div>
    </section>

    <DeleteAccountSection client:load />
  </div>
</Dashboard>
