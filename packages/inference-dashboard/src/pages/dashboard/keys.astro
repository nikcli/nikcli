---
import Dashboard from "../../layouts/Dashboard.astro"
import ApiKeysPanel from "../../components/ApiKeysPanel"
---

<Dashboard active="keys" title="API Keys · nikcli Inference">
  <div class="app-page">
    <div class="app-header">
      <div>
        <p class="app-kicker">Credentials</p>
        <h1 class="app-title">API Keys</h1>
        <p class="app-subtitle">
          Use each key as <code class="app-code">Authorization: Bearer $NIKCLI_API_KEY</code> against
          <code class="app-code">https://inference.nikcli-ai.dev/v1</code>. Full keys are only shown once.
        </p>
      </div>
    </div>
    <div class="app-panel app-panel-pad">
      <ApiKeysPanel client:load />
    </div>
  </div>
</Dashboard>
