{
  "name": "@nikcli-ai/devhub",
  "private": true,
  "version": "1.431.0",
  "type": "module",
  "license": "MIT",
  "description": "Local admin dashboard and developer platform for nikcli: processes, memory, tests, benchmarks, API",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite",
