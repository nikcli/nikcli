    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@nikcli-ai/sdk": "workspace:*",
    "@nikcli-ai/ui": "workspace:*",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "effect": "4.0.0-rc.112",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "^2",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
