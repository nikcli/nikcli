{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.378.0",
  "name": "nikcli-ai",
  "description": "AI coding agent with TUI, server, connectors and mobile companion — a fork of OpenCode (https://github.com/anomalyco/opencode)",
  "type": "module",
  "license": "MIT",
  "private": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix",
    "lint:slop": "bunx oxlint -c oxlint.slop.config.ts",
    "format": "bunx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "bunx prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "bun run --parallel format:check lint",
    "test": "bun test --parallel --timeout 30000 --path-ignore-patterns='**/*benchmark*.test.ts' --path-ignore-patterns='**/*integration*.test.ts'",
    "test:ci": "bun run script/test-ci.ts",
    "test:unit": "bun test --parallel --timeout 30000 --path-ignore-patterns='**/*benchmark*.test.ts' --path-ignore-patterns='**/*integration*.test.ts' --path-ignore-patterns='test/workspace/**' --path-ignore-patterns='test/worktree/**' --path-ignore-patterns='test/session/**' --path-ignore-patterns='test/database/**' --path-ignore-patterns='test/tui/**'",
    "test:integration": "bun test --timeout 60000 --path-ignore-patterns='**/*benchmark*.test.ts' test/workspace test/worktree test/session test/database",
    "test:coverage": "bun test --coverage --timeout 30000 --path-ignore-patterns='**/*benchmark*.test.ts' --path-ignore-patterns='**/*integration*.test.ts'",
    "test:bench": "bun test --timeout 60000 test/benchmarks",
    "test:e2e": "bun test --timeout 60000 test/tui",
    "bench": "bun run --conditions=browser test/bench/viz.tsx",
    "bench:compare": "bun run script/bench-compare.ts",
    "build": "bun run script/build.ts",
    "build:single": "bun run script/build.ts --single",
    "dev:bin": "bun run build:single && dist/*/bin/nikcli",
    "smoke:tui": "bun run script/tui-smoke.ts",
    "bench:startup": "bun run script/tui-startup.ts",
    "bench:baseline": "bun run script/perf-baseline.ts --samples 30 --json specs/perf-baseline.json",
    "generate:httpapi-clients": "bun run script/generate-httpapi-clients.ts",
    "check:routes": "bun run script/check-route-coverage.ts",
    "check:open-payloads": "bun run script/check-open-payloads.ts",
    "check:account-required": "bun run script/check-account-required.ts",
    "check:observability-schema": "bun run script/check-observability-schema.ts",
    "check:plugin-v2": "bun run script/check-plugin-v2.ts",
    "check:workspace-isolation": "bun run script/check-workspace-isolation.ts",
    "check:network-egress": "bun run script/check-network-egress.ts",
    "check:flag-capture": "bun run script/check-flag-capture.ts",
    "check:spec-commit-refs": "bun run script/check-spec-commit-refs.ts",
    "check:perf-baseline": "bun run script/check-perf-baseline.ts",
    "check:spec-paths": "bun run script/check-spec-paths.ts",
    "dev": "bun run --conditions=browser ./src/index.ts",
    "clean": "echo 'Cleaning up...' && rm -rf node_modules dist",
    "docs": "echo 'Generating documentation...' && find src -name '*.ts' -exec echo 'Processing: {}' \\;",
    "deploy": "echo 'Deploying application...' && bun run build && echo 'Deployment completed successfully'",
    "release": "bun run ../../script/release-github.ts",
    "sandbox:vercel": "bun run script/vercel-sandbox-smoke.ts"
  },
  "bin": {
    "nikcli": "./bin/nikcli"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#fff": {
      "bun": "./src/file/fff.bun.ts",
      "node": "./src/file/fff.node.ts",
      "default": "./src/file/fff.bun.ts"
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@nikcli-ai/script": "workspace:*",
    "@octokit/webhooks-types": "7.6.1",
    "@oxlint/plugins": "1.79.0",
    "@parcel/watcher-darwin-arm64": "2.5.6",
