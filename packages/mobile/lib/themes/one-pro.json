{
  "$schema": "https://nikcli-ai.dev/theme.json",
  "defs": {
    "bg": "#1e2127",
    "bgAlt": "#1a1d21",
    "fg": "#abb2bf",
    "fgAlt": "#5c6370",
    "selection": "#3e4451",
    "lineBg": "#1e2127",
    "gutterBg": "#1e2127",
    "gutterFg": "#5c6370",
    "red": "#e06c75",
    "redLight": "#e06c75",
    "green": "#98c379",
    "greenLight": "#98c379",
    "yellow": "#e5c07b",
    "yellowLight": "#e5c07b",
    "blue": "#61afef",
    "blueLight": "#61afef",
    "purple": "#c678dd",
    "purpleLight": "#c678dd",
    "cyan": "#56b6c2",
    "cyanLight": "#56b6c2",
    "orange": "#d19a66",
    "gray": "#5c6370"
