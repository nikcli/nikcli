{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nikcli-ai/plugin",
  "version": "1.369.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:plugins": "bun run script/build-plugins.ts",
    "publish:plugins": "bun run script/publish-plugins.ts"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tool": {
      "import": "./src/tool.ts",
      "types": "./src/tool.ts"
    },
    "./tui": {
      "import": "./src/tui.ts",
      "types": "./src/tui.ts"
    },
    "./v2/tui": {
      "import": "./src/v2/tui/index.ts",
      "types": "./src/v2/tui/index.ts"
    },
    "./v2/manifest": {
      "import": "./src/v2/manifest.ts",
      "types": "./src/v2/manifest.ts"
    },
    "./v2/tui/*": {
      "import": "./src/v2/tui/*.ts",
      "types": "./src/v2/tui/*.ts"
    },
    "./v2/ade": {
      "import": "./src/v2/ade/index.ts",
      "types": "./src/v2/ade/index.ts"
    },
    "./v2/ade/*": {
      "import": "./src/v2/ade/*.ts",
      "types": "./src/v2/ade/*.ts"
    },
    "./v2/effect": {
      "import": "./src/v2/effect/index.ts",
      "types": "./src/v2/effect/index.ts"
    },
    "./v2/effect/tool": {
      "import": "./src/v2/effect/tool.ts",
      "types": "./src/v2/effect/tool.ts"
    },
    "./v2/promise": {
      "import": "./src/v2/promise/index.ts",
      "types": "./src/v2/promise/index.ts"
    },
    "./v2/promise/tool": {
      "import": "./src/v2/promise/tool.ts",
      "types": "./src/v2/promise/tool.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./tool": "./dist/tool.js",
      "./tui": "./dist/tui.js",
      "./v2/tui": "./dist/v2/tui/index.js",
      "./v2/tui/*": "./dist/v2/tui/*.js",
      "./v2/ade": "./dist/v2/ade/index.js",
      "./v2/ade/*": "./dist/v2/ade/*.js",
      "./v2/effect": "./dist/v2/effect/index.js",
      "./v2/effect/tool": "./dist/v2/effect/tool.js",
      "./v2/promise": "./dist/v2/promise/index.js",
      "./v2/promise/tool": "./dist/v2/promise/tool.js"
    }
  },
  "dependencies": {
    "@nikcli-ai/sdk": "workspace:*",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "effect": "4.0.0-rc.112",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  }
}