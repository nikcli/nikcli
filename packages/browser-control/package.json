{
  "name": "@nikcli-ai/browser-control",
  "version": "1.376.0",
  "private": true,
  "description": "Control, inspect, capture and test real web pages headlessly, in the background — a browser-control engine for nikcli, sibling to @nikcli-ai/terminal-control.",
  "license": "MIT",
  "bin": {
    "browser-control": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "bundle": "bun src/cli.ts bundle",
    "control": "bun src/cli.ts",
    "install-skill": "bun src/cli.ts install-skill",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@nikcli-ai/util": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
