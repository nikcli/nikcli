          {/* ── Activity ─────────────────────────────────────────────────── */}
          {grid && grid.weeks > 0 && (
            <section class="page-shell pb-14" aria-labelledby="activity-heading" id="activity">
              <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
                <p class="viz-source">Hosted gateway</p>
                <h2 id="activity-heading" class="font-display text-panel-title text-terminal-text">
                  A year of traffic
                </h2>
                <p class="mt-2 max-w-2xl text-body-sm text-terminal-muted">
                  Tokens per day over the last {gateway.activityDays} days, one square per day. Shade is that day's
                  share of the busiest day.
                </p>

                <dl class="mt-6 grid grid-cols-3 gap-x-6 gap-y-5">
                  <div>
                    <dt class="text-eyebrow uppercase text-terminal-muted">Days with traffic</dt>
                    <dd class="mt-1 font-sans text-xl font-semibold text-terminal-text">
                      {whole.format(gateway.activityStats.activeDays)}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-eyebrow uppercase text-terminal-muted">Longest streak</dt>
                    <dd class="mt-1 font-sans text-xl font-semibold text-terminal-text">
                      {whole.format(gateway.activityStats.longestStreak)} days
                    </dd>
                  </div>
                  <div>
                    <dt class="text-eyebrow uppercase text-terminal-muted">Gateway tokens · 365d</dt>
                    <dd class="mt-1 font-sans text-xl font-semibold text-terminal-text">
                      {compact.format(gateway.activityStats.total)}
                    </dd>
                  </div>
                </dl>

                <div class="mt-6 overflow-x-auto">
                  <svg
                    viewBox={`0 0 ${GRID_GUTTER + grid.weeks * CELL_PITCH} ${GRID_HEADER + 7 * CELL_PITCH}`}
                    width={GRID_GUTTER + grid.weeks * CELL_PITCH}
                    height={GRID_HEADER + 7 * CELL_PITCH}
                    role="img"
                    aria-label={`Tokens per day over the last ${gateway.activityDays} days. ${whole.format(gateway.activityStats.activeDays)} days had traffic, the busiest ${compact.format(gateway.activityStats.maxDay)} tokens.`}
                  >
                    {grid.monthLabels.map((month) => (
                      <text x={GRID_GUTTER + month.col * CELL_PITCH} y={GRID_HEADER - 5} class="viz-tick">
                        {month.label}
                      </text>
                    ))}
                    {WEEKDAY_LABELS.map((weekday) => (
                      <text
                        x={GRID_GUTTER - 6}
                        y={GRID_HEADER + weekday.row * CELL_PITCH + CELL - 1}
                        text-anchor="end"
                        class="viz-tick"
                      >
                        {weekday.label}
                      </text>
                    ))}
                    {grid.cells.map((week, row) =>
                      week.map((value, col) => {
                        const day = cellDay(row, col)
                        return (
                          <rect
                            x={GRID_GUTTER + col * CELL_PITCH}
                            y={GRID_HEADER + row * CELL_PITCH}
                            width={CELL}
                            height={CELL}
                            rx="2"
                            fill={day === null ? "currentColor" : `var(--heat-${activityStep(value, grid.maxValue)})`}
                            class={day === null ? "viz-heat-none" : activityStep(value, grid.maxValue) === 0 ? "viz-heat-empty" : undefined}
                          >
                            {day !== null && (
                              <title>{`${day.toISOString().slice(0, 10)}: ${whole.format(value)} tokens`}</title>
                            )}
                          </rect>
                        )
                      }),
                    )}
                  </svg>
                </div>

                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-terminal-muted">
                  <span class="flex items-center gap-2">
                    <span class="viz-heat-none-key h-2.5 w-2.5 rounded-[2px]" aria-hidden="true" />
                    No data
                  </span>
                  <span class="flex items-center gap-2">
                  <span>Quieter</span>
                  {[0, 1, 2, 3, 4, 5].map((step) => (
                    <span
                      class={`h-2.5 w-2.5 rounded-[2px]${step === 0 ? " viz-heat-empty" : ""}`}
                      style={`background:var(--heat-${step})`}
                      aria-hidden="true"
                    />
                  ))}
                  <span>Busier</span>
                  </span>
                </div>
              </div>
            </section>
          )}

          {/* ── Leaderboard ──────────────────────────────────────────────── */}
          <section class="page-shell pb-14" aria-labelledby="leaderboard-heading" id="leaderboard">
            <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
              <p class="viz-source">Hosted gateway</p>
              <h2 id="leaderboard-heading" class="font-display text-panel-title text-terminal-text">
                Model leaderboard
              </h2>
              <p class="mt-2 max-w-2xl text-body-sm text-terminal-muted">
                Ranked by tokens over the last {WINDOW_DAYS} days. Change compares against the {WINDOW_DAYS} days before
                that; a model with no traffic then shows no change instead of an infinite one.
                {gateway.models.length > LEADERBOARD_ROWS && (
                  <> Showing the top {LEADERBOARD_ROWS} of {gateway.models.length} models routed.</>
                )}
              </p>
              {/* Seven columns will not fit a phone, and a sideways-scrolling
                  table hides its own columns with no affordance — so on small
                  screens each model becomes a card carrying the same values. */}
              <ul class="mt-6 space-y-3 md:hidden">
                {leaderboard.map((model, index) => (
                  <li class="rounded-md border border-terminal-border/60 p-4">
                    <div class="flex items-center gap-2.5">
                      <span class="tabular-nums text-body-sm text-terminal-muted">{index + 1}</span>
                      {colorOf(model.model) ? (
                        <span
                          class="h-2.5 w-2.5 shrink-0 rounded-[2px]"
                          style={`background:${colorOf(model.model)}`}
                          aria-hidden="true"
                        />
                      ) : (
                        <span class="h-2.5 w-2.5 shrink-0" aria-hidden="true" />
                      )}
                      <span class="truncate font-mono text-[13px] text-terminal-text">{model.model}</span>
                    </div>
                    <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3">
                      <div>
                        <dt class="text-eyebrow uppercase text-terminal-muted">Tokens</dt>
                        <dd class="mt-0.5 tabular-nums text-body-sm text-terminal-text">
                          {compactFixed.format(model.tokens)} · {percent.format(model.share)}
                        </dd>
                      </div>
                      <div>
                        <dt class="text-eyebrow uppercase text-terminal-muted">Completions</dt>
                        <dd class="mt-0.5 tabular-nums text-body-sm text-terminal-text">
                          {whole.format(model.requests)}
                        </dd>
                      </div>
                      <div>
                        <dt class="text-eyebrow uppercase text-terminal-muted">Provider</dt>
                        <dd class="mt-0.5 truncate text-body-sm text-terminal-text">
                          {model.provider}
                        </dd>
                      </div>
                      <div>
                        <dt class="text-eyebrow uppercase text-terminal-muted">Change</dt>
                        <dd class="mt-0.5 tabular-nums text-body-sm text-terminal-text">
                          {model.change === null ? (
                            "new"
                          ) : (
                            <>
                              <span aria-hidden="true" class={changeClass[changeDirection(model.change)]}>
                                {changeArrow[changeDirection(model.change)]}
                              </span>{" "}
                              {changeDirection(model.change) === "flat"
                                ? "flat"
                                : signedPercent.format(model.change)}
                            </>
                          )}
                        </dd>
                      </div>
                    </dl>
                  </li>
                ))}
              </ul>

              <div class="mt-6 hidden overflow-x-auto md:block">
                <table class="w-full min-w-[720px] border-collapse text-body-sm">
                  <caption class="sr-only">
                    Models ranked by tokens served in the last {WINDOW_DAYS} days
                  </caption>
                  <thead>
                    <tr class="border-b border-terminal-border/60 text-left">
                      <th scope="col" class="py-3 pr-3 text-eyebrow uppercase font-semibold text-terminal-muted">#</th>
                      <th scope="col" class="py-3 pr-3 text-eyebrow uppercase font-semibold text-terminal-muted">Model</th>
                      <th scope="col" class="py-3 pr-3 text-eyebrow uppercase font-semibold text-terminal-muted">Provider</th>
                      <th scope="col" class="py-3 pr-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">Tokens</th>
                      <th scope="col" class="py-3 pr-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">Share</th>
                      <th scope="col" class="py-3 pr-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">Completions</th>
                      <th scope="col" class="py-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">Change</th>
                    </tr>
                  </thead>
                  <tbody>
                    {leaderboard.map((model, index) => (
                      <tr class="border-b border-terminal-border/40 last:border-0">
                        <td class="py-3 pr-3 tabular-nums text-terminal-muted">{index + 1}</td>
                        <td class="py-3 pr-3">
                          <span class="flex items-center gap-2.5">
                            {colorOf(model.model) ? (
                              <span
                                class="h-2.5 w-2.5 shrink-0 rounded-[2px]"
                                style={`background:${colorOf(model.model)}`}
                                aria-hidden="true"
                              />
                            ) : (
                              <span class="h-2.5 w-2.5 shrink-0" aria-hidden="true" />
                            )}
                            <span class="font-mono text-[13px] text-terminal-text">{model.model}</span>
                          </span>
                        </td>
                        <td class="py-3 pr-3 text-terminal-muted">{model.provider}</td>
                        <td class="py-3 pr-3 text-right tabular-nums text-terminal-text">
                          {compactFixed.format(model.tokens)}
                        </td>
                        <td class="py-3 pr-3 text-right tabular-nums text-terminal-muted">{percent.format(model.share)}</td>
                        <td class="py-3 pr-3 text-right tabular-nums text-terminal-muted">
                          {whole.format(model.requests)}
                        </td>
                        <td class="py-3 text-right tabular-nums">
                          {model.change === null ? (
                            <span class="text-terminal-muted">new</span>
                          ) : (
                            <span class="inline-flex items-center gap-1">
                              <span aria-hidden="true" class={changeClass[changeDirection(model.change)]}>
                                {changeArrow[changeDirection(model.change)]}
                              </span>
                              <span class="text-terminal-text">
                                {changeDirection(model.change) === "flat"
                                  ? "flat"
                                  : signedPercent.format(model.change)}
                              </span>
                            </span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          {/* ── What a call costs ────────────────────────────────────────── */}
          {/* One table, not two bar lists. Cost per call is price per token
              times tokens per call, so as separate charts the two drew the same
              shape twice and the third column — the one that explains the
              difference — was buried in a caption. */}
          <section class="page-shell pb-14" aria-labelledby="cost-heading" id="cost">
            <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
              <p class="viz-source">Hosted gateway</p>
              <h2 id="cost-heading" class="font-display text-panel-title text-terminal-text">
                What a call costs
              </h2>
              <p class="mt-2 max-w-2xl text-body-sm text-terminal-muted">
                Gateway models, dearest per token first. Price is billed dollars divided by tokens served, so cached
                reads and the input/output mix are already in it — a rate card would not be. Across everything:
                {" "}{money(gateway.totals.pricePerMillion, 2)} per million, {money(gateway.totals.costPerRequest, 4)}
                {" "}a call, at {compact.format(gateway.totals.tokensPerRequest)} tokens each.
                {priceLeaders.total > priceLeaders.rows.length && (
                  <> Showing the dearest {priceLeaders.rows.length} of {priceLeaders.total}.</>
                )}
              </p>
              <div class="mt-6 overflow-x-auto">
                <table class="w-full min-w-[520px] border-collapse text-body-sm">
                  <caption class="sr-only">
                    Gateway models ranked by blended price per million tokens, last {gateway.windowDays} days
                  </caption>
                  <thead>
                    <tr class="border-b border-terminal-border/60 text-left">
                      <th scope="col" class="py-3 pr-3 text-eyebrow uppercase font-semibold text-terminal-muted">Model</th>
                      <th scope="col" class="py-3 pr-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">Per 1M tokens</th>
                      <th scope="col" class="py-3 pr-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">Tokens per call</th>
                      <th scope="col" class="py-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">Per call</th>
                    </tr>
                  </thead>
                  <tbody>
                    {priceLeaders.rows.map((model) => (
                      <tr class="border-b border-terminal-border/40 last:border-0">
                        <td class="py-3 pr-3">
                          <span class="flex items-center gap-2.5">
                            {colorOf(model.model) ? (
                              <span
                                class="h-2.5 w-2.5 shrink-0 rounded-[2px]"
                                style={`background:${colorOf(model.model)}`}
                                aria-hidden="true"
                              />
                            ) : (
                              <span class="h-2.5 w-2.5 shrink-0" aria-hidden="true" />
                            )}
                            <span class="font-mono text-[13px] text-terminal-text">{model.model}</span>
                          </span>
                        </td>
                        <td class="py-3 pr-3 text-right tabular-nums text-terminal-text">
                          {money(model.pricePerMillion, 2)}
                        </td>
                        <td class="py-3 pr-3 text-right tabular-nums text-terminal-muted">
                          {compactFixed.format(model.tokensPerRequest)}
                        </td>
                        <td class="py-3 text-right tabular-nums text-terminal-text">
                          {money(model.costPerRequest, 4)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          {/* ── Cache & providers ────────────────────────────────────────── */}
          <div class="page-shell grid items-stretch gap-6 pb-14 lg:grid-cols-2">
            <section
              class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8"
              aria-labelledby="cache-heading"
              id="cache"
            >
              <p class="viz-source">Hosted gateway</p>
              <h2 id="cache-heading" class="font-display text-panel-title text-terminal-text">
                Cache hit ratio
              </h2>
              <p class="mt-2 text-body-sm text-terminal-muted">
                Share of input tokens read from cache rather than re-sent, over the last {gateway.windowDays} days.
                Taken over input only — an output token is generated every time, so it can never be cached. Across
                every model:
                {" "}{compact.format(gateway.totals.cacheReadTokens)} cached against
                {" "}{compact.format(gateway.totals.inputTokens)} sent.
                {cacheLeaders.total > cacheLeaders.rows.length && (
                  <> Showing the {cacheLeaders.rows.length} best of {cacheLeaders.total}.</>
                )}
              </p>
              {cacheLeaders.rows.length === 0 ? (
                <p class="mt-6 text-body-sm text-terminal-muted">No model in this window sent input tokens.</p>
              ) : (
                <ul class="mt-6 space-y-3.5">
                  {cacheLeaders.rows.map((model) => (
                    <li>
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="flex min-w-0 items-center gap-2.5">
                          {colorOf(model.model) && (
                            <span
                              class="h-2.5 w-2.5 shrink-0 rounded-[2px]"
                              style={`background:${colorOf(model.model)}`}
                              aria-hidden="true"
                            />
                          )}
                          <span class="truncate font-mono text-[13px] text-terminal-text">{model.model}</span>
                        </span>
                        <span class="shrink-0 tabular-nums text-body-sm text-terminal-text">
                          {percent.format(model.cacheRatio!)}
                        </span>
                      </div>
                      <span class="viz-track mt-1.5 block h-2 overflow-hidden rounded-full" aria-hidden="true">
                        <span
                          class="block h-full rounded-full"
                          style={`width:${Math.max(model.cacheRatio! * 100, 1)}%;background:var(--series-1)`}
                        />
                      </span>
                      <p class="mt-1 text-[13px] tabular-nums text-terminal-muted">
                        {compactFixed.format(model.cacheReadTokens)} cached ·{" "}
                        {compactFixed.format(model.inputTokens)} sent
                      </p>
                    </li>
                  ))}
                </ul>
              )}
            </section>

            <section
              class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8"
              aria-labelledby="providers-heading"
              id="providers"
            >
              <p class="viz-source">Hosted gateway</p>
              <h2 id="providers-heading" class="font-display text-panel-title text-terminal-text">
                Provider share
              </h2>
              <p class="mt-2 text-body-sm text-terminal-muted">
                Which upstream served the tokens over the last {gateway.windowDays} days. A model reached by more
                than one provider is counted under each.
              </p>
              <ul class="mt-6 space-y-3.5">
                {gateway.providers.map((provider) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="truncate text-body-sm text-terminal-text">{provider.provider}</span>
                      <span class="shrink-0 tabular-nums text-body-sm text-terminal-text">
                        {percent.format(provider.share)}
                      </span>
                    </div>
                    <span class="viz-track mt-1.5 block h-2 overflow-hidden rounded-full" aria-hidden="true">
                      <span
                        class="block h-full rounded-full"
                        style={`width:${Math.max(provider.share * 100, 0.25)}%;min-width:2px;background:var(--series-1)`}
                      />
                    </span>
                    <p class="mt-1 text-[13px] tabular-nums text-terminal-muted">
                      {compactFixed.format(provider.tokens)} tokens · {whole.format(provider.requests)} completions
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          </div>
        </>
      )
    }

    {/* ── Adoption ───────────────────────────────────────────────────────── */}
    {
      downloads.length > 1 && (
        <section class="page-shell pb-14" aria-labelledby="adoption-heading" id="adoption">
          <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <div>
                <p class="viz-source">Release log</p>
                <h2 id="adoption-heading" class="font-display text-panel-title text-terminal-text">
                  Adoption
                </h2>
                <p class="mt-2 max-w-2xl text-body-sm text-terminal-muted">
                  Cumulative installs since {shortDay(firstDownload.date)}, recorded by the release workflow in
                  STATS.md. Plotted on a real time axis — the log is written on release days, not daily.
                </p>
              </div>
              <p class="text-body-sm text-terminal-muted">
                <span class="font-semibold text-terminal-text">{whole.format(lastDownload.total)}</span> total
              </p>
            </div>

            <div class="mt-6 overflow-x-auto">
            <svg
              viewBox={`0 0 ${CHART_W} ${PAD.top + DOWNLOADS_H + PAD.bottom}`}
              class="w-full min-w-[520px]"
              role="img"
              aria-label={`Cumulative installs, reaching ${whole.format(lastDownload.total)} by ${shortDay(lastDownload.date)}. Every recorded figure is in the table below.`}
            >
              {downloadTicks.map((tick) => (
                <>
                  <line
                    x1={PAD.left}
                    x2={CHART_W - PAD.right}
                    y1={downloadY(tick)}
                    y2={downloadY(tick)}
                    class="viz-grid"
                  />
                  <text x={PAD.left - 10} y={downloadY(tick) + 4} text-anchor="end" class="viz-tick">
                    {downloadTick(tick)}
                  </text>
                </>
              ))}
              <polyline
                points={downloadLine}
                fill="none"
                stroke="var(--series-1)"
                stroke-width="2"
                stroke-linejoin="round"
                stroke-linecap="round"
              />
              <circle
                cx={downloadX(lastDownload.date)}
                cy={downloadY(lastDownload.total)}
                r="4.5"
                fill="var(--series-1)"
                class="viz-endpoint"
              />
              {downloadAxisDates.map((point) => (
                <text
                  x={downloadX(point.date)}
                  y={PAD.top + DOWNLOADS_H + 20}
                  text-anchor={point.anchor}
                  class="viz-tick"
                >
                  {shortDay(point.date)}
                </text>
              ))}
            </svg>
            </div>

            <p class="mt-8 text-body-sm text-terminal-muted">
              The {Math.min(DOWNLOAD_TABLE_ROWS, downloads.length)} most recent of {downloads.length} readings, split by
              source. Readings are taken on release days, so the dates are not consecutive.
            </p>
            <div class="mt-3 overflow-x-auto">
              <table class="w-full min-w-[420px] border-collapse text-body-sm">
                <caption class="sr-only">Recorded download totals, newest first</caption>
                <thead>
                  <tr class="border-b border-terminal-border/60 text-left">
                    <th scope="col" class="py-3 pr-3 text-eyebrow uppercase font-semibold text-terminal-muted">Recorded</th>
                    <th scope="col" class="py-3 pr-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">npm</th>
                    <th scope="col" class="py-3 pr-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">GitHub</th>
                    <th scope="col" class="py-3 text-right text-eyebrow uppercase font-semibold text-terminal-muted">Total</th>
                  </tr>
                </thead>
                <tbody>
                  {[...downloads].reverse().slice(0, DOWNLOAD_TABLE_ROWS).map((point) => (
                    <tr class="border-b border-terminal-border/40 last:border-0">
                      <td class="py-2.5 pr-3 text-terminal-muted">{shortDay(point.date)}</td>
                      <td class="py-2.5 pr-3 text-right tabular-nums text-terminal-text">{whole.format(point.npm)}</td>
                      <td class="py-2.5 pr-3 text-right tabular-nums text-terminal-text">{whole.format(point.github)}</td>
                      <td class="py-2.5 text-right tabular-nums text-terminal-text">{whole.format(point.total)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      )
    }

    {/* ── Where downloads come from ──────────────────────────────────────── */}
    {
      downloadGeo && (
        <section class="page-shell pb-14">
          <GeoBreakdown
            id="download-geo"
            source="Edge counter"
            heading="Where downloads come from"
            blurb={`Downloads that passed nikcli-ai.dev/releases/download — the URL the install scripts fetch from — resolved to a country at the edge and then handed to GitHub, which serves the file and counts it as it always has. GitHub and npm publish a download total with no geography attached, so this is measured here rather than derived from either, and it counts only from the day the route shipped${lastDownload ? `: the ${whole.format(lastDownload.total)} in the release log above have no country and never will` : ""}.`}
            stats={downloadGeo}
            format={(value) => whole.format(value)}
            unit="downloads"
          />
        </section>
      )
    }

    {/* ── Methodology ────────────────────────────────────────────────────── */}
    <section class="page-shell pb-20" aria-labelledby="method-heading">
      <div class="rounded-card border border-terminal-border/60 bg-terminal-panel/60 p-6 sm:p-8">
        <h2 id="method-heading" class="font-display text-card-title text-terminal-text">How this is measured</h2>
        <dl class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <dt class="text-body-sm font-semibold text-terminal-text">Sources</dt>
            <dd class="mt-1 text-body-sm text-terminal-muted">
              Gateway figures are one row per served completion, written to the same table billing reads. Community
              figures are what installs report about the models they run themselves. Adoption comes from
              STATS.md in the repository.
            </dd>
          </div>
          <div>
            <dt class="text-body-sm font-semibold text-terminal-text">Time windows</dt>
            <dd class="mt-1 text-body-sm text-terminal-muted">
              Headline figures and the leaderboard cover {WINDOW_DAYS} days; the charts cover {SERIES_DAYS}. Change
              compares consecutive {WINDOW_DAYS}-day windows.
            </dd>
          </div>
          <div>
            <dt class="text-body-sm font-semibold text-terminal-text">Privacy</dt>
            <dd class="mt-1 text-body-sm text-terminal-muted">
              Only aggregates are queried. No account, key or request identifier is read, so nothing here can be traced
              to a user. Prompt content is never stored in the first place. Community reporting is off unless you turn
              it on, and the identifier an install sends is random, local, and never published.
            </dd>
          </div>
          <div>
            <dt class="text-body-sm font-semibold text-terminal-text">Freshness</dt>
            <dd class="mt-1 text-body-sm text-terminal-muted">
              Rendered {updatedAt} UTC and cached at the edge for 15 minutes.
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  {gateway !== null && <script is:inline type="application/json" data-token-series="gateway" set:html={tooltipJson} />}
  {community !== null && (
    <script is:inline type="application/json" data-token-series="community" set:html={communityTooltipJson} />
  )}
</Layout>

<style>
  /* Validated categorical palette (dataviz slots 1–8) stepped for each mode.
     Light surface #ffffff and dark surface #0d0d0f are the panel colours these
     charts actually render on; both modes pass the adjacent CVD and
     normal-vision gates. The light steps sit under 3:1 on white, so the
     leaderboard table ships the same values as text. */
  .viz {
    --series-1: #2a78d6;
    --series-2: #eb6834;
    --series-3: #1baf7a;
    --series-4: #eda100;
    --series-5: #e87ba4;
    --series-6: #008300;
    --series-7: #4a3aa7;
    --series-8: #e34948;
    --series-other: #9c9a92;
    --viz-grid: rgb(var(--terminal-border));
    --viz-surface: rgb(var(--terminal-panel));

    /* Sequential blue ramp for the activity grid — one hue, light to dark, with
       a neutral empty step so "no traffic" never reads as "a little traffic". */
    --heat-0: #e8f1fd;
    --heat-1: #cde2fb;
    --heat-2: #9ec5f4;
    --heat-3: #5598e7;
    --heat-4: #2a78d6;
    --heat-5: #184f95;
  }

  :root[data-theme="dark"] .viz {
    --series-1: #3987e5;
    --series-2: #d95926;
    --series-3: #199e70;
    --series-4: #c98500;
    --series-5: #d55181;
    --series-6: #008300;
    --series-7: #9085e9;
    --series-8: #e66767;
    --series-other: #6e6b64;
    /* Dark steps run the ramp the other way: the deepest blue would vanish into
       the panel, so the busiest day is the lightest step. */
    --heat-0: #1b3e6b;
    --heat-1: #184f95;
    --heat-2: #256abf;
    --heat-3: #3987e5;
    --heat-4: #6da7ec;
    --heat-5: #9ec5f4;
  }

  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .viz {
      --series-1: #3987e5;
      --series-2: #d95926;
      --series-3: #199e70;
      --series-4: #c98500;
      --series-5: #d55181;
      --series-6: #008300;
      --series-7: #9085e9;
      --series-8: #e66767;
      --series-other: #6e6b64;
    /* Dark steps run the ramp the other way: the deepest blue would vanish into
       the panel, so the busiest day is the lightest step. */
    --heat-0: #1b3e6b;
    --heat-1: #184f95;
    --heat-2: #256abf;
    --heat-3: #3987e5;
    --heat-4: #6da7ec;
    --heat-5: #9ec5f4;
    }
  }

  .viz-grid {
    stroke: var(--viz-grid);
    stroke-width: 1;
  }

  .viz-tick {
    fill: rgb(var(--terminal-muted));
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .viz-label {
    fill: rgb(var(--terminal-text));
    font-family: "Figtree", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
  }

  /* Source tag. Small, quiet, and on every card — the page's whole claim is
     that its two halves are different things, so each one says which it is. */
  .viz-source {
    display: inline-block;
    margin-bottom: 0.6rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid rgb(var(--terminal-border));
    border-radius: var(--radius-sm);
    color: rgb(var(--terminal-muted));
    font-size: var(--type-eyebrow);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .viz-heat-none,
  .viz-heat-none-key {
    fill: rgb(var(--terminal-border) / 0.45);
    background: rgb(var(--terminal-border) / 0.45);
  }

  .viz-heat-empty {
    box-shadow: inset 0 0 0 1px rgb(var(--terminal-border));
  }

  .viz-track {
    background: rgb(var(--terminal-border) / 0.55);
  }

  .viz-endpoint {
    stroke: var(--viz-surface);
    stroke-width: 2;
  }

  .viz-cursor {
    stroke: rgb(var(--terminal-text) / 0.35);
    stroke-width: 1.5;
    opacity: 0;
  }

  .viz-plot svg:focus-visible {
    outline: 2px solid rgb(var(--terminal-accent));
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .viz-tooltip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    min-width: 9.5rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid rgb(var(--terminal-border));
    border-radius: var(--radius-md);
    background: rgb(var(--terminal-panel));
    box-shadow: var(--shadow-strong);
    pointer-events: none;
    transform: translateX(-50%);
  }

  .viz-tooltip[hidden] {
    display: none;
  }
</style>

<script>
  const initTokenChart = (svg: SVGSVGElement) => {
    const key = svg.dataset.tokenChart
    const host = svg.closest<HTMLElement>("[data-tooltip-host]")
    const tooltip = host?.querySelector<HTMLElement>("[data-tooltip]")
    const cursor = svg.querySelector<SVGRectElement>("[data-cursor]")
    const payload = document.querySelector<HTMLScriptElement>(`[data-token-series="${key}"]`)
    if (!host || !tooltip || !cursor || !payload) return

    type Row = { model: string; value: string; color: string }
    type Column = { day: string; total: string; requests: string; rows: Row[] }
    let columns: Column[] = []
    try {
      columns = JSON.parse(payload.textContent ?? "[]")
    } catch {
      return
    }
    if (columns.length === 0) return

    const hitAreas = [...svg.querySelectorAll<SVGRectElement>("[data-column]")]
    let active = -1

    // Series names come from the database, so every one of them is inserted as
    // text, never as markup.
    const render = (index: number) => {
      const column = columns[index]
      const target = hitAreas[index]
      if (!column || !target) return
      active = index
      tooltip.replaceChildren()

      const day = document.createElement("p")
      day.className = "text-[11px] uppercase tracking-wider text-terminal-muted"
      day.textContent = column.day
      tooltip.append(day)

      const total = document.createElement("p")
      total.className = "mt-0.5 text-sm font-semibold text-terminal-text"
      total.textContent = `${column.total} tokens`
      tooltip.append(total)

      const meta = document.createElement("p")
      meta.className = "text-[12px] text-terminal-muted"
      meta.textContent = column.requests
      tooltip.append(meta)

      if (column.rows.length > 0) {
        const list = document.createElement("ul")
        list.className = "mt-2 space-y-1 border-t border-terminal-border/60 pt-2"
        for (const row of column.rows) {
          const item = document.createElement("li")
          item.className = "flex items-center justify-between gap-3 text-[12px]"
          const name = document.createElement("span")
          name.className = "flex min-w-0 items-center gap-1.5 text-terminal-muted"
          const key = document.createElement("span")
          key.className = "h-0.5 w-3 shrink-0 rounded-full"
          key.style.background = row.color
          const label = document.createElement("span")
          label.className = "truncate font-mono"
          label.textContent = row.model
          name.append(key, label)
          const value = document.createElement("span")
          value.className = "shrink-0 font-semibold tabular-nums text-terminal-text"
          value.textContent = row.value
          item.append(name, value)
          list.append(item)
        }
        tooltip.append(list)
      }

      const area = target.getBoundingClientRect()
      const bounds = host.getBoundingClientRect()
      tooltip.hidden = false
      // Anchored inside the plot and kept clear of both edges: the card scrolls
      // horizontally on small screens, so a tooltip hanging past its bounds
      // would be clipped rather than merely overhang.
      tooltip.style.left = "0px"
      tooltip.style.top = "0px"
      const width = tooltip.getBoundingClientRect().width
      const centre = area.left - bounds.left + host.scrollLeft + area.width / 2
      const limit = Math.max(host.scrollWidth - width / 2 - 8, width / 2 + 8)
      tooltip.style.left = `${Math.min(Math.max(centre, width / 2 + 8), limit)}px`
      tooltip.style.top = `${area.top - bounds.top + 8}px`

      cursor.setAttribute("x", target.getAttribute("x") ?? "0")
      cursor.setAttribute("width", target.getAttribute("width") ?? "0")
      cursor.style.opacity = "1"
    }

    const clear = () => {
      active = -1
      tooltip.hidden = true
      cursor.style.opacity = "0"
    }

    hitAreas.forEach((area, index) => {
      area.addEventListener("pointerenter", () => render(index))
    })
    svg.addEventListener("pointerleave", clear)
    svg.addEventListener("blur", clear)
    svg.addEventListener("focus", () => render(active >= 0 ? active : columns.length - 1))
    svg.addEventListener("keydown", (event) => {
      const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0
      if (step === 0) {
        if (event.key === "Escape") clear()
        return
      }
      event.preventDefault()
      render(Math.min(Math.max((active < 0 ? columns.length - 1 : active) + step, 0), columns.length - 1))
    })
  }

  const initTokenCharts = () => {
    document.querySelectorAll<SVGSVGElement>("[data-token-chart]").forEach(initTokenChart)
  }

  initTokenCharts()
  document.addEventListener("astro:page-load", initTokenCharts)
</script>
