---
/**
 * /data — what nikcli's own inference gateway actually did.
 *
 * Every gateway number is a SUM over the `usage` table the gateway bills from,
 * reached through the aggregate feed the console deployment publishes — see
 * src/lib/publicStats.ts, and packages/console/app/src/routes/data.json.ts for
 * the queries and for what is deliberately not published. The adoption series
 * is STATS.md, appended by the download-stats workflow. Nothing is modelled:
 * with no rows in the window the gateway sections say so instead of drawing
 * zeroes.
 */
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/Navbar.astro"
import GeoBreakdown from "../components/GeoBreakdown.astro"
import statsMarkdown from "../../../../STATS.md?raw"
import {
  ACTIVITY_DAYS,
  axisTicks,
  fetchCommunity,
  fetchDownloadGeo,
  fetchGateway,
  GEO_DAYS,
  parseDownloads,
  SERIES_DAYS,
  WINDOW_DAYS,
  type SeriesPoint,
} from "../lib/publicStats"

const env = Astro.locals.runtime?.env
const now = Math.floor(Date.now() / 1000)
// The binding carries the feed URL in production; `import.meta.env` lets a
// local `.env` point `astro dev` at a deployed console without one.
const [gateway, community] = await Promise.all([
  fetchGateway(env?.CONSOLE_DATA_URL ?? import.meta.env.CONSOLE_DATA_URL, now),
  fetchCommunity(env?.COMMUNITY_DATA_URL ?? import.meta.env.COMMUNITY_DATA_URL, now),
])
const downloads = parseDownloads(statsMarkdown)
// Where those downloads came from. Counted at our own edge by
// /releases/download/*, the URL both installers already fetch from, because
// neither GitHub nor npm publishes a country for a download. `null` until that
// route has seen traffic, and the section is then simply absent.
const downloadGeo = await fetchDownloadGeo(env?.DOWNLOADS, GEO_DAYS)

// The page is public and identical for everyone, so it is worth caching at the
// edge: without this every visit re-fetches the console feed.
Astro.response.headers.set("cache-control", "public, max-age=900, s-maxage=900")

const compact = new Intl.NumberFormat("en-US", { notation: "compact", maximumFractionDigits: 1 })
const whole = new Intl.NumberFormat("en-US")
/** Compact with a fixed decimal, so a column of them aligns: 8.1B, 243.8M, 65.0M. */
/**
 * One unit for a whole axis. Formatting each tick on its own gives a column
 * reading 2.5K, 2K, 1.5K, 1K, 500 — five ticks in two different units.
 */
const axisFormat = (ticks: number[]) => {
  const max = ticks[ticks.length - 1] ?? 0
  const [divisor, suffix] = max >= 1e9 ? [1e9, "B"] : max >= 1e6 ? [1e6, "M"] : max >= 1e3 ? [1e3, "K"] : [1, ""]
  const scaled = new Intl.NumberFormat("en-US", { maximumFractionDigits: 1 })
  return (value: number) => (value === 0 ? "0" : `${scaled.format(value / divisor)}${suffix}`)
}

const compactFixed = new Intl.NumberFormat("en-US", {
  notation: "compact",
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
})
const percent = new Intl.NumberFormat("en-US", { style: "percent", minimumFractionDigits: 1, maximumFractionDigits: 1 })
const signedPercent = new Intl.NumberFormat("en-US", {
  style: "percent",
  maximumFractionDigits: 0,
  signDisplay: "exceptZero",
})
const money = (value: number, digits = 2) =>
  new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: digits,
    maximumFractionDigits: digits,
  }).format(value)
const shortDay = (day: string) => {
  const [y, m, d] = day.split("-").map(Number)
  return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  })
}

/**
 * One colour ordering for the whole page, not one per chart.
 *
 * Both halves band their own top models, and a reader who learns "sonnet is
 * blue" in the community chart must not meet a different blue model in the
 * gateway chart. So the slots are assigned from the union of the two banded
 * sets — four each, which is why the union fits the eight validated slots — and
 * every swatch, band and table row then agrees across the page.
 *
 * A model outside that union has no colour of its own: it is drawn inside the
 * grey "other" band and carries no swatch, so two different models are never
 * shown wearing the same one.
 */
const bandedModels = [
  ...new Set(
    [...(gateway?.seriesModels ?? []), ...(community?.seriesModels ?? [])].filter((model) => model !== "other"),
  ),
]
const slotOf = new Map(bandedModels.map((model, index) => [model, index + 1]))
/** `null` when the model has no slot of its own. */
const colorOf = (model: string): string | null => {
  if (model === "other") return "var(--series-other)"
  const slot = slotOf.get(model)
  return slot !== undefined && slot <= 8 ? `var(--series-${slot})` : null
}
/** The colour a chart mark is painted with; everything unslotted shares the "other" grey. */
const bandColor = (model: string) => colorOf(model) ?? "var(--series-other)"

/**
 * Movement under a percent is reported as flat, without an arrow or a colour:
 * "▼ 0%" reads as a contradiction, and a column of coloured ±1% triangles reads
 * as churn where the data has none.
 */
const changeDirection = (change: number): "up" | "down" | "flat" =>
  Math.abs(change) < 0.01 ? "flat" : change > 0 ? "up" : "down"
const changeClass = { up: "text-terminal-success", down: "text-terminal-error", flat: "text-terminal-muted" }
const changeArrow = { up: "▲", down: "▼", flat: "—" }

// ── Chart geometry ────────────────────────────────────────────────────────────
// Charts are plain SVG sized in a 1000-unit viewBox and scaled by CSS, so the
// page ships no charting library and no client-side layout pass.
const CHART_W = 1000
const PAD = { left: 62, right: 16, top: 12, bottom: 28 }
const SEGMENT_GAP = 1
const plotW = CHART_W - PAD.left - PAD.right

function topRoundedBar(x: number, y: number, w: number, h: number): string {
  const r = Math.min(4, w / 2, h)
  return `M${x},${y + h} L${x},${y + r} Q${x},${y} ${x + r},${y} L${x + w - r},${y} Q${x + w},${y} ${x + w},${y + r} L${x + w},${y + h} Z`
}

const series = gateway?.series ?? []
const seriesModels = gateway?.seriesModels ?? []

const TOKENS_H = 236
/** Column pitch is shared by every daily chart so their x-axes line up. */
const slot = plotW / Math.max(Math.max(series.length, community?.series.length ?? 0), 1)
const barW = Math.min(24, Math.max(3, slot - 3))

/** Lays out one stacked column per day. Used by both the gateway and the community chart. */
function stackColumns(points: SeriesPoint[], models: string[], height: number, max: number) {
  return points.map((point, index) => {
    const x = PAD.left + index * slot + (slot - barW) / 2
    const bands = models
      .map((model) => ({ model, tokens: point.byModel[model] ?? 0 }))
      .filter((band) => band.tokens > 0)
    let bottom = PAD.top + height
    const segments = bands.map((band, i) => {
      const raw = (band.tokens / max) * height
      const top = bottom - raw
      bottom = top
      return {
        ...band,
        x,
        y: top,
        // The gap that separates touching segments is taken off the bottom of
        // every segment except the one on the baseline, and it shrinks with the
        // segment: a full 2px out of a 3px band would erase the band and leave
        // the top of the stack looking like a barcode.
        height: Math.max(raw - (i > 0 && raw > 6 ? SEGMENT_GAP : 0), 0.75),
        rounded: i === bands.length - 1,
      }
    })
    return { day: point.day, tokens: point.tokens, requests: point.requests, x, segments }
  })
}

/** Lays out one plain column per day, for the single-series charts. */
function plainColumns(points: SeriesPoint[], value: (point: SeriesPoint) => number, height: number, max: number) {
  return points.map((point, index) => {
    const drawn = (value(point) / max) * height
    return {
      day: point.day,
      value: value(point),
      x: PAD.left + index * slot + (slot - barW) / 2,
      y: PAD.top + height - drawn,
      height: Math.max(drawn, value(point) > 0 ? 1 : 0),
    }
  })
}

const peak = (points: SeriesPoint[], value: (point: SeriesPoint) => number) =>
  points.reduce<SeriesPoint | null>((best, point) => (best === null || value(point) > value(best) ? point : best), null)

// Stacked tokens per day.
const tokenTicks = axisTicks(Math.max(0, ...series.map((p) => p.tokens)))
const tokenMax = tokenTicks[tokenTicks.length - 1]
const tokenColumns = stackColumns(series, seriesModels, TOKENS_H, tokenMax)
const peakDay = peak(series, (point) => point.tokens)

// Daily requests — one series, so one color and no legend.
const REQUESTS_H = 120
const requestTicks = axisTicks(Math.max(0, ...series.map((p) => p.requests)))
const requestMax = requestTicks[requestTicks.length - 1]
const requestColumns = plainColumns(series, (point) => point.requests, REQUESTS_H, requestMax)
const requestPeak = peak(series, (point) => point.requests)

// Community reports — the same two charts over what installs run themselves.
const communitySeries = community?.series ?? []
const communityTicks = axisTicks(Math.max(0, ...communitySeries.map((p) => p.tokens)))
const communityMax = communityTicks[communityTicks.length - 1]
const communityColumns = stackColumns(communitySeries, community?.seriesModels ?? [], TOKENS_H, communityMax)
const communityPeak = peak(communitySeries, (point) => point.tokens)
const installsByDay = new Map((community?.installs ?? []).map((row) => [row.day, row.installs]))
const installTicks = axisTicks(Math.max(0, ...(community?.installs ?? []).map((row) => row.installs)))
const installMax = installTicks[installTicks.length - 1]
const installColumns = plainColumns(
  communitySeries,
  (point) => installsByDay.get(point.day) ?? 0,
  REQUESTS_H,
  installMax,
)
const installPeak = peak(communitySeries, (point) => installsByDay.get(point.day) ?? 0)
const installPeakValue = installPeak ? (installsByDay.get(installPeak.day) ?? 0) : 0

// Activity grid — the same contribution-style picture nikcli's own analytics
// view draws, from the shared helper in @nikcli-ai/util/activity.
const CELL = 17
const CELL_GAP = 4
const CELL_PITCH = CELL + CELL_GAP
const GRID_GUTTER = 30
const GRID_HEADER = 16
const grid = gateway?.activityGrid
const gridStartMs = grid?.startDate ? Date.parse(`${grid.startDate}T00:00:00Z`) : 0
const gridFirstDow = grid?.startDate ? (new Date(gridStartMs).getUTCDay() + 6) % 7 : 0
const gridEndMs = grid?.endDate ? Date.parse(`${grid.endDate}T00:00:00Z`) : 0
/** The day a (row, column) cell stands for, or `null` for the padding before day one. */
const cellDay = (row: number, col: number): Date | null => {
  const offset = col * 7 + row - gridFirstDow
  if (offset < 0) return null
  const at = gridStartMs + offset * 86_400_000
  return at > gridEndMs ? null : new Date(at)
}
/**
 * Six steps of one hue: empty, then five shades of the sequential blue ramp.
 * Thresholds are shares of the busiest day, so the ramp always spans the data.
 */
const activityStep = (value: number, max: number): number => {
  if (value <= 0) return 0
  const share = max > 0 ? value / max : 0
  if (share <= 0.1) return 1
  if (share <= 0.3) return 2
  if (share <= 0.6) return 3
  if (share <= 0.85) return 4
  return 5
}
const WEEKDAY_LABELS = [
  { row: 0, label: "Mon" },
  { row: 2, label: "Wed" },
  { row: 4, label: "Fri" },
]

const axisDays = series
  .map((point, index) => ({ ...point, index }))
  .filter(({ index }) => index % 10 === 0 || index === series.length - 1)

// Adoption — cumulative installs on a real time axis, so the irregular
// recording interval cannot read as an even cadence. One line, not one per
// source: npm outruns GitHub releases roughly twenty to one, and two series
// that far apart put the smaller one flat on the axis where it says nothing.
// The split lives in the table underneath, at full precision.
const DOWNLOADS_H = 200
const DOWNLOAD_TABLE_ROWS = 8
const firstDownload = downloads[0]
const lastDownload = downloads[downloads.length - 1]
const downloadFrom = Date.parse(firstDownload?.date ?? "1970-01-01")
const downloadSpan = Math.max(Date.parse(lastDownload?.date ?? "1970-01-02") - downloadFrom, 1)
const downloadTicks = axisTicks(Math.max(0, ...downloads.map((p) => p.total)))
const downloadMax = downloadTicks[downloadTicks.length - 1]
const downloadX = (date: string) => PAD.left + ((Date.parse(date) - downloadFrom) / downloadSpan) * plotW
const downloadY = (value: number) => PAD.top + DOWNLOADS_H - (value / downloadMax) * DOWNLOADS_H
const downloadLine = downloads.map((p) => `${downloadX(p.date).toFixed(1)},${downloadY(p.total).toFixed(1)}`).join(" ")
// Ticks are placed at even points in time, not every nth record, so a burst of
// releases in one week cannot crowd the axis.
const downloadAxisDates = Array.from({ length: 5 }, (_, i) => {
  const at = downloadFrom + (downloadSpan / 4) * i
  return {
    date: new Date(at).toISOString().slice(0, 10),
    anchor: i === 0 ? "start" : i === 4 ? "end" : "middle",
  }
})

// Anchors for sections that are actually on the page: with no gateway rows the
// nav would otherwise offer six links that scroll nowhere.
/**
 * Model names come from the database, so a serialised tooltip payload is
 * escaped before it is written inside a script element: an unescaped closing
 * script tag in a name would close the element early and let whatever follows
 * be parsed as markup. `<` is a valid JSON string escape, so the payload still
 * parses unchanged. The two line separators are escaped for the same reason.
 *
 * The tags are spelled out in prose rather than written literally: vite's
 * dependency scanner reads this file as markup and treats a script tag in a
 * comment as a real one, then fails to parse the sentence after it as
 * JavaScript.
 */
const escapeForScript = (value: unknown) =>
  JSON.stringify(value).replace(
    /[<\u2028\u2029]/g,
    (character) => `\\u${character.charCodeAt(0).toString(16).padStart(4, "0")}`,
  )

/**  differs by feed: the gateway counts completions, installs report messages. */
/** `unit` differs by feed: the gateway counts completions, installs report messages. */
const tokenTick = axisFormat(tokenTicks)
const requestTick = axisFormat(requestTicks)
const communityTick = axisFormat(communityTicks)
const installTick = axisFormat(installTicks)
const downloadTick = axisFormat(downloadTicks)

const tooltipRows = (columns: typeof tokenColumns, unit: string) =>
  columns.map((column) => ({
    day: shortDay(column.day),
    total: compact.format(column.tokens),
    requests: `${whole.format(column.requests)} ${unit}`,
    rows: [...column.segments].reverse().map((segment) => ({
      model: segment.model,
      value: compact.format(segment.tokens),
      color: bandColor(segment.model),
    })),
  }))

const tooltipJson = escapeForScript(tooltipRows(tokenColumns, "completions"))
const communityTooltipJson = escapeForScript(tooltipRows(communityColumns, "assistant messages"))

// Grouped by feed, because the two halves are the page's whole point and an
// undifferentiated row of chips hides that. Every chip repeats its section's
// heading verbatim, so a reader lands on the words they clicked.
const sectionGroups = [
  {
    label: "Community reports",
    sections: community
      ? [
          { id: "community", label: "Models developers run" },
          { id: "community-tokens", label: "Tokens by model, reported" },
          { id: "community-installs", label: "Installs reporting each day" },
          { id: "community-models", label: "Every model reported" },
        ]
      : [],
  },
  {
    label: "Hosted gateway",
    sections: gateway
      ? [
          { id: "gateway", label: "Through the hosted gateway" },
          { id: "models", label: "Tokens by model, billed" },
          { id: "requests", label: "Completions per day" },
          { id: "activity", label: "A year of traffic" },
          { id: "leaderboard", label: "Model leaderboard" },
          { id: "cost", label: "What a call costs" },
          { id: "cache", label: "Cache hit ratio" },
          { id: "providers", label: "Provider share" },
        ]
      : [],
  },
  {
    label: "Release log",
    sections: [
      ...(downloads.length > 1 ? [{ id: "adoption", label: "Adoption" }] : []),
      ...(downloadGeo ? [{ id: "download-geo", label: "Where downloads come from" }] : []),
    ],
  },
].filter((group) => group.sections.length > 0)

const LEADERBOARD_ROWS = 20
const leaderboard = (gateway?.models ?? []).slice(0, LEADERBOARD_ROWS)

/**
 * Every bar list is ranked by the value it draws, not by token volume: a chart
 * of cost whose rows run in traffic order makes the reader hunt for the most
 * expensive model instead of reading it off the top.
 */
const BAR_ROWS = 10
const ranked = <T,>(rows: T[], by: (row: T) => number) => [...rows].sort((a, b) => by(b) - by(a))
/** Ranked and cut, with the count kept so the heading can admit the cut. */
const topBy = <T,>(rows: T[], by: (row: T) => number) => {
  const all = ranked(rows, by)
  return { rows: all.slice(0, BAR_ROWS), total: all.length }
}
const priceLeaders = topBy(gateway?.models ?? [], (m) => m.pricePerMillion)
const cacheLeaders = topBy(
  (gateway?.models ?? []).filter((m) => m.cacheRatio !== null),
  (m) => m.cacheRatio ?? 0,
)
const updatedAt = new Date(now * 1000).toLocaleString("en-US", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
})
---

<Layout
  title="Data | nikcli"
  description="Real usage from the nikcli inference gateway: token volume by model, request cost, cache hit ratio, provider share, and adoption over time."
>
  <Navbar />

  <main id="main-content" class="viz flex-1">
    <!-- ── Header ─────────────────────────────────────────────────────────── -->
    <section class="page-shell pt-12 pb-8 sm:pt-16">
      <p class="text-eyebrow uppercase text-terminal-accent">Data</p>
      <h1 class="mt-3 max-w-3xl font-display text-page-title text-terminal-text">
        What nikcli actually runs on
      </h1>
      <p class="mt-4 max-w-2xl text-body-md text-terminal-muted">
        Two telemetry sources, kept apart because they measure different things: what installs report about the
        models they run on their own provider keys, and what the hosted gateway billed. Every card says which one it
        is drawing. Adoption, at the end, comes from a third — the public release log. Nothing is modelled, smoothed
        or back-filled.
      </p>

      <nav class="mt-8 space-y-4" aria-label="Sections on this page">
        {
          sectionGroups.map((group) => (
            <div class="flex flex-wrap items-center gap-2">
              <span class="w-full text-eyebrow uppercase text-terminal-muted sm:w-auto sm:pr-2">{group.label}</span>
              {group.sections.map((section) => (
                <a
                  href={`#${section.id}`}
                  class="rounded-md border border-terminal-border/60 bg-terminal-panel/70 px-3 py-1.5 text-[13px] font-medium text-terminal-muted transition-colors duration-100 hover:border-terminal-accent/40 hover:text-terminal-text"
                >
                  {section.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </section>

    {/* ── What installs run on their own keys ──────────────────────────────
        The gateway sections below only see traffic that went through the
        gateway. Most people bring their own provider keys, so this is the
        larger picture — and the one that says which models developers pick. */}
    {
      community && (
        <section class="page-shell space-y-6 pb-14" aria-labelledby="community-heading" id="community">
          <div class="rounded-card border border-terminal-border/60 bg-terminal-panel p-6 sm:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <div>
                <p class="viz-source">Community reports</p>
                <h2 id="community-heading" class="font-display text-panel-title text-terminal-text">
                  Models developers run
                </h2>
                <p class="mt-2 max-w-2xl text-body-sm text-terminal-muted">
                  Reported by nikcli installs — including models run on their own provider keys, which never touch the
                  nikcli gateway. Figures cover the last {community.windowDays} days; the chart below covers
                  {community.seriesDays}.
                </p>
              </div>
            </div>

            {/* The page's one hero figure lives here, on the larger of the two
                feeds. The gateway total below it is a stat tile, not a rival. */}
            <div class="mt-7 border-t border-terminal-border/50 pt-7">
              <p class="text-eyebrow uppercase text-terminal-muted">
                Tokens reported · last {community.windowDays} days
              </p>
              <p class="mt-2 font-sans text-[clamp(3rem,7vw,4.5rem)] font-bold leading-none tracking-tight text-terminal-text">
                {compact.format(community.totals.tokens)}
              </p>
              {community.totals.change !== null && (
                <p class="mt-3 flex items-center gap-1.5 text-body-sm">
                  <span aria-hidden="true" class={changeClass[changeDirection(community.totals.change)]}>
                    {changeArrow[changeDirection(community.totals.change)]}
                  </span>
                  <span class="font-semibold text-terminal-text">
                    {changeDirection(community.totals.change) === "flat"
                      ? "Flat"
                      : signedPercent.format(community.totals.change)}
                  </span>
                  <span class="text-terminal-muted">vs the {community.windowDays} days before</span>
                </p>
              )}
            </div>

            <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-3">
              <div>
                <dt class="text-eyebrow uppercase text-terminal-muted">Installs reporting</dt>
                <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                  {compact.format(community.totals.installs)}
                </dd>
              </div>
              <div>
                <dt class="text-eyebrow uppercase text-terminal-muted">Models seen</dt>
                <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">{community.totals.models}</dd>
              </div>
              <div>
                <dt class="text-eyebrow uppercase text-terminal-muted">Assistant messages</dt>
                <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                  {compact.format(community.totals.messages)}
                </dd>
              </div>
            </dl>

            {community.totals.sessions > 0 && (
              <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-7 border-t border-terminal-border/50 pt-7 sm:grid-cols-4">
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Cost per session</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                    {money(community.totals.costPerSession, 4)}
                  </dd>
                </div>
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Tokens per session</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                    {compact.format(community.totals.tokensPerSession)}
                  </dd>
                </div>
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Blended $/1M</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                    {money(community.totals.pricePerMillion)}
                  </dd>
                </div>
                <div>
                  <dt class="text-eyebrow uppercase text-terminal-muted">Cache hit</dt>
                  <dd class="mt-1.5 font-sans text-2xl font-semibold text-terminal-text">
                    {community.totals.cacheRatio === null ? "—" : percent.format(community.totals.cacheRatio)}
                  </dd>
                </div>
              </dl>
            )}

            {community.authors.length > 1 && (
              <>
                <h3 class="mt-10 font-display text-card-title text-terminal-text">Share by model author</h3>
                <p class="mt-1.5 max-w-2xl text-body text-terminal-muted">
                  Tokens grouped by the organisation that made the model, across every provider that served it.
                </p>
                <ul class="mt-5 space-y-3">
                  {community.authors.map((author) => (
                    <li class="flex items-center gap-3">
                      <span class="w-28 shrink-0 font-mono text-[13px] text-terminal-text">{author.author}</span>
                      <span class="viz-track h-1.5 flex-1 overflow-hidden rounded-full" aria-hidden="true">
                        <span
                          class="block h-full rounded-full"
                          style={`width:${Math.max(author.share * 100, 1)}%;background:var(--series-1)`}
                        />
                      </span>
                      <span class="w-16 shrink-0 text-right tabular-nums text-terminal-muted">
                        {percent.format(author.share)}
                      </span>
                      <span class="w-24 shrink-0 text-right tabular-nums text-terminal-muted">
                        {compact.format(author.tokens)}
                      </span>
                    </li>
                  ))}
                </ul>
