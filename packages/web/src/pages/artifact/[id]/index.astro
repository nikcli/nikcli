---
import {
  canViewArtifact,
  publicMeta,
  readArtifact,
  readArtifactContent,
  resolveViewerUserId,
} from "../../../lib/artifact"
import { renderMarkdown } from "../../../lib/artifact-markdown"
import ThemeIcons from "../../../components/ThemeIcons.astro"

export const prerender = false

// Viewer URLs can carry a read capability. Never cache their HTML shell: aside
// from protecting the key, this prevents stale pages from referencing assets
// from a previous deployment.
Astro.response.headers.set("Cache-Control", "private, no-store")

const env = (Astro.locals as App.Locals).runtime?.env
const id = Astro.params.id ?? ""

const stored = env?.ARTIFACTS && id ? await readArtifact(env.ARTIFACTS, id) : null
if (!stored) {
  Astro.response.status = 404
}

const key = Astro.url.searchParams.get("key")
const userId = stored && env ? await resolveViewerUserId(env, Astro.request) : null
const authorized = stored ? canViewArtifact(stored, { userId, key }) : false
if (stored && !authorized) {
  Astro.response.status = userId ? 403 : 401
}

const meta = stored && authorized ? publicMeta(stored) : null

// Markdown and plain text render inside the viewer shell, so fetch the body here.
let textBody = ""
if (env?.ARTIFACTS && meta && (meta.kind === "markdown" || meta.kind === "text")) {
  const object = await readArtifactContent(env.ARTIFACTS, meta.id, meta.version)
  textBody = object ? await object.text() : ""
}
const markdownHtml = meta?.kind === "markdown" ? renderMarkdown(textBody) : ""

// When access came from a ?key capability, media/iframe requests need it too
// (the browser has no login cookie in that case).
const rawUrl = meta ? `/artifact/${meta.id}/raw${key ? `?key=${encodeURIComponent(key)}` : ""}` : ""
const updated = meta ? new Date(meta.time.updated).toUTCString() : ""
const pageTitle = meta
  ? `${meta.title} — nikcli artifact`
  : stored
    ? "Private artifact — nikcli"
    : "Artifact not found — nikcli"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    {meta?.description ? <meta name="description" content={meta.description} /> : null}
    <ThemeIcons />
    <script is:inline>
      const storedTheme = localStorage.getItem("theme")
      const prefersDark = window.matchMedia?.("(prefers-color-scheme: dark)").matches
      document.documentElement.setAttribute("data-theme", storedTheme || (prefersDark ? "dark" : "light"))
    </script>
  </head>
  <body>
    <header class="bar">
      <div class="bar-left">
        <a class="brand" href="/" aria-label="nikcli home">
          <span class="brand-fallback" aria-hidden="true">nikcli</span>
          <img class="brand-light" src="/brand/wordmark-light.png" alt="" width="95" height="31" />
          <img class="brand-dark" src="/brand/wordmark-dark.png" alt="" width="95" height="31" />
        </a>
        {meta ? <span class="kind">{meta.kind}</span> : null}
        {meta ? <span class="title" title={meta.filename}>{meta.title}</span> : null}
      </div>
      <div class="bar-right">
        {meta ? <span class="meta-line">v{meta.version} · {updated}</span> : null}
        {meta ? <button class="copy" id="copy-link" type="button">Copy link</button> : null}
      </div>
    </header>

    {
      !stored ? (
        <main class="empty">
          <h1>Artifact not found</h1>
          <p>This artifact does not exist or was removed.</p>
        </main>
      ) : !authorized ? (
        <main class="empty">
          <section class="gate">
            <h1>Private artifact</h1>
            <p>
              Sign in with the publisher's nikcli account to view it, or open the link exactly as it was shared
              (including its <code>?key=</code> part).
            </p>
            <a class="login-link" href={`/user/authorize?return_to=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}>Sign in securely</a>
          </section>
        </main>
      ) : meta!.kind === "html" ? (
        <iframe class="frame" src={rawUrl} sandbox="allow-scripts allow-popups" title={meta!.title} />
      ) : meta!.kind === "image" ? (
        <main class="media">
          <img src={rawUrl} alt={meta!.title} />
        </main>
      ) : meta!.kind === "video" ? (
        <main class="media">
          <video src={rawUrl} controls playsinline preload="metadata" />
        </main>
      ) : meta!.kind === "markdown" ? (
        <main class="doc" set:html={markdownHtml} />
      ) : (
        <main class="doc">
          <pre class="plain">{textBody}</pre>
        </main>
      )
    }

    <script>
      const copyButton = document.getElementById("copy-link")
      copyButton?.addEventListener("click", () => {
        void navigator.clipboard.writeText(window.location.href).then(() => {
          copyButton.textContent = "Copied"
          setTimeout(() => {
            copyButton.textContent = "Copy link"
          }, 1500)
        })
      })

      const brand = document.querySelector(".brand")
      const brandImages = document.querySelectorAll<HTMLImageElement>(".brand img")
      const showImageBrand = () => {
        if ([...brandImages].some((image) => image.complete && image.naturalWidth > 0)) {
          brand?.classList.add("has-image")
        }
      }
      brandImages.forEach((image) => image.addEventListener("load", showImageBrand, { once: true }))
      showImageBrand()

    </script>

    <!-- Keep the viewer shell self-contained. Artifact links must remain usable
         while hashed site assets are rolling out or stale in an embedded webview. -->
    <style is:inline>
      :root {
        color-scheme: light;
        --terminal-bg: 250 249 246;
        --terminal-panel: 255 255 255;
        --terminal-border: 220 214 200;
        --terminal-text: 12 11 10;
        --terminal-muted: 110 104 94;
        --terminal-accent: 37 99 235;
        --terminal-error: 220 38 38;
        --terminal-code: 244 242 238;
        --terminal-shadow: 10 8 4;
        --topbar-height: 4rem;
        --page-gutter: clamp(1rem, 2vw + 0.5rem, 1.5rem);
        --radius-md: 10px;
        --radius-card: 16px;
        --shadow-soft: 0 2px 16px -2px rgb(var(--terminal-shadow) / 0.08), 0 1px 3px rgb(var(--terminal-shadow) / 0.04);
        --shadow-strong: 0 12px 40px -6px rgb(var(--terminal-shadow) / 0.14), 0 4px 12px -2px rgb(var(--terminal-shadow) / 0.06);
      }
      [data-theme="dark"] {
        color-scheme: dark;
        --terminal-bg: 8 8 9;
        --terminal-panel: 13 13 15;
        --terminal-border: 32 30 27;
        --terminal-text: 242 240 236;
        --terminal-muted: 148 144 136;
        --terminal-accent: 96 165 250;
        --terminal-error: 248 113 113;
        --terminal-code: 18 17 16;
        --terminal-shadow: 0 0 0;
        --shadow-soft: 0 2px 16px -2px rgb(0 0 0 / 0.4), 0 1px 3px rgb(0 0 0 / 0.2);
        --shadow-strong: 0 12px 40px -6px rgb(0 0 0 / 0.6), 0 4px 12px -2px rgb(0 0 0 / 0.3);
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        height: 100%;
      }
      body {
        display: flex;
        flex-direction: column;
        min-width: 320px;
        background-color: rgb(var(--terminal-bg));
        background-image:
          linear-gradient(rgb(var(--terminal-border) / 0.2) 1px, transparent 1px),
          linear-gradient(90deg, rgb(var(--terminal-border) / 0.2) 1px, transparent 1px);
        background-size: 48px 48px;
        color: rgb(var(--terminal-text));
        font-family: "Figtree", system-ui, sans-serif;
      }
      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: var(--topbar-height);
        padding: 10px var(--page-gutter);
        border-bottom: 1px solid rgb(var(--terminal-border) / 0.6);
        background: rgb(var(--terminal-bg) / 0.86);
        backdrop-filter: blur(18px);
      }
      .bar-left,
      .bar-right {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
      }
      .brand {
        position: relative;
        display: flex;
        align-items: center;
        min-width: 75px;
        height: 25px;
        color: rgb(var(--terminal-text));
        text-decoration: none;
        white-space: nowrap;
        transition: opacity 150ms ease;
      }
      .brand:hover {
        opacity: 0.82;
      }
      .brand img {
        position: absolute;
        inset: 0 auto auto 0;
        width: auto;
        height: 25px;
      }
      .brand-fallback {
        font-family: "Syne", system-ui, sans-serif;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: -0.08em;
        line-height: 1;
      }
      .brand.has-image .brand-fallback {
        visibility: hidden;
      }
      .brand-dark {
        display: none;
      }
      [data-theme="dark"] .brand-light {
        display: none;
      }
      [data-theme="dark"] .brand-dark {
        display: block;
      }
      .kind {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: rgb(var(--terminal-accent));
        border: 1px solid rgb(var(--terminal-accent) / 0.22);
        border-radius: 999px;
        background: rgb(var(--terminal-accent) / 0.08);
        padding: 2px 8px;
        white-space: nowrap;
      }
      .title {
        font-size: 13px;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .meta-line {
        font-size: 11px;
        color: rgb(var(--terminal-muted));
        white-space: nowrap;
      }
      .copy {
        font: inherit;
        font-size: 12px;
        font-weight: 600;
        color: rgb(var(--terminal-text));
        background: rgb(var(--terminal-panel));
        border: 1px solid rgb(var(--terminal-border));
        border-radius: var(--radius-md);
        padding: 7px 12px;
        cursor: pointer;
        box-shadow: var(--shadow-soft);
        transition: border-color 150ms ease, color 150ms ease, transform 150ms ease;
      }
      .copy:hover {
        border-color: rgb(var(--terminal-accent) / 0.5);
        color: rgb(var(--terminal-accent));
      }
      .frame {
        flex: 1;
        width: 100%;
        border: 0;
        background: #ffffff;
      }
      .media {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        overflow: auto;
      }
      .media img,
      .media video {
        max-width: 100%;
        max-height: calc(100vh - 110px);
        border-radius: var(--radius-card);
        border: 1px solid rgb(var(--terminal-border));
        background: #000;
      }
      .media img {
        background: transparent;
      }
      .doc {
        flex: 1;
        overflow: auto;
        padding: 32px 20px 64px;
      }
      .doc > * {
        max-width: 760px;
        margin-left: auto;
        margin-right: auto;
      }
      .doc h1,
      .doc h2,
      .doc h3 {
        line-height: 1.25;
      }
      .doc pre {
        background: rgb(var(--terminal-code));
        border: 1px solid rgb(var(--terminal-border));
        border-radius: var(--radius-md);
        padding: 14px;
        overflow-x: auto;
      }
      .doc code {
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: 0.9em;
      }
      .doc a {
        color: rgb(var(--terminal-accent));
      }
      .doc blockquote {
        border-left: 3px solid rgb(var(--terminal-accent));
        margin: 12px auto;
        padding: 2px 14px;
        color: rgb(var(--terminal-muted));
      }
      .plain {
        white-space: pre-wrap;
        word-break: break-word;
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: 13px;
      }
      .empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: rgb(var(--terminal-muted));
        padding: 24px;
      }
      .empty h1 {
        color: rgb(var(--terminal-text));
        font-family: "Syne", system-ui, sans-serif;
        font-size: clamp(24px, 6vw, 30px);
        letter-spacing: -0.03em;
        margin: 0;
      }
      .gate {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: min(420px, 100%);
        padding: clamp(24px, 6vw, 32px);
        border: 1px solid rgb(var(--terminal-border));
        border-radius: var(--radius-card);
        background: rgb(var(--terminal-panel) / 0.96);
        box-shadow: var(--shadow-strong);
        text-align: center;
      }
      .gate p {
        margin: 0;
        font-size: 13px;
      }
      .login-link {
        display: block;
        padding: 10px 12px;
        border-radius: var(--radius-md);
        background: rgb(var(--terminal-accent));
        color: rgb(var(--terminal-bg));
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }
      .gate input {
        font: inherit;
        font-size: 14px;
        color: rgb(var(--terminal-text));
        background: rgb(var(--terminal-bg));
        border: 1px solid rgb(var(--terminal-border));
        border-radius: var(--radius-md);
        padding: 10px 12px;
      }
      .gate input:focus {
        outline: none;
        border-color: rgb(var(--terminal-accent));
        box-shadow: 0 0 0 3px rgb(var(--terminal-accent) / 0.18);
      }
      .gate button {
        font: inherit;
        font-size: 14px;
        font-weight: 700;
        color: rgb(var(--terminal-bg));
        background: rgb(var(--terminal-accent));
        border: 0;
        border-radius: var(--radius-md);
        padding: 10px 12px;
        cursor: pointer;
      }
      .gate button[disabled] {
        opacity: 0.6;
      }
      .gate-error {
        color: rgb(var(--terminal-error));
        font-size: 12px;
      }
      @media (max-width: 640px) {
        .bar {
          align-items: flex-start;
          padding: 11px 14px;
        }
        .bar-left {
          flex-wrap: wrap;
        }
        .meta-line {
          display: none;
        }
        .title {
          max-width: min(50vw, 220px);
        }
        .doc {
          padding: 24px 16px 48px;
        }
      }
    </style>
  </body>
</html>
