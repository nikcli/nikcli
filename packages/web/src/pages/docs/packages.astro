---
export const prerender = true

import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCallout from "../../components/docs/DocCallout.astro";
import DocCard from "../../components/docs/DocCard.astro";

const toc = [
  { title: "Overview", href: "#overview", depth: 2 },
  { title: "@nikcli-ai/llm", href: "#llm", depth: 2 },
  { title: "@nikcli-ai/http-recorder", href: "#http-recorder", depth: 2 },
  { title: "Full Package Table", href: "#package-table", depth: 2 },
];

const packages = [
  {
    name: "@nikcli-ai/nikcli",
    path: "packages/nikcli",
    role: "Core CLI, TUI, agent runtime, session management, HTTP server, and all built-in tools. The primary deliverable.",
  },
  {
    name: "@nikcli-ai/llm",
    path: "packages/llm",
    role: "Multi-provider LLM client: route-based model refs, protocol adapters (Anthropic, OpenAI, Gemini, Bedrock, and more), tool-use runtime, and Effect-native streaming.",
  },
  {
    name: "@nikcli-ai/http-recorder",
    path: "packages/http-recorder",
    role: "Record-and-replay HTTP (and WebSocket) test fixture library used by @nikcli-ai/llm's provider test suite.",
  },
  {
    name: "@nikcli-ai/sdk",
    path: "packages/sdk/js",
    role: "Public JavaScript/TypeScript SDK exposing the nikcli client, server utilities, cloud sync helpers, and generated API types.",
  },
  {
    name: "@nikcli-ai/plugin",
    path: "packages/plugin",
    role: "TypeScript types and utilities for authoring nikcli plugins, including the PluginInput contract and tool-definition helpers.",
  },
  {
    name: "@nikcli-ai/inference",
    path: "packages/inference",
    role: "Self-hosted OpenAI-compatible inference gateway that routes to 14 upstream providers, caches responses, and applies per-tier rate limiting.",
  },
  {
    name: "@nikcli-ai/inference-dashboard",
    path: "packages/inference-dashboard",
    role: "Astro-based admin dashboard for the inference gateway, surfacing provider health, usage, and cache statistics.",
  },
  {
    name: "@nikcli-ai/cloud",
    path: "packages/cloud",
    role: "Cloudflare-Workers backend providing JWT auth, device registration, encrypted session storage (D1), and WebSocket relay via Durable Objects.",
  },
  {
    name: "@nikcli-ai/remote",
    path: "packages/remote",
    role: "WebSocket terminal-server that lets mobile and web clients access a running nikcli session remotely, with optional tunnel and QR-code pairing.",
  },
  {
    name: "@nikcli-ai/companion",
    path: "packages/companion",
    role: "Companion server and UI for pairing remote clients with a local nikcli session.",
  },
  {
    name: "@nikcli-ai/desktop",
    path: "packages/desktop",
    role: "Native desktop application built with Tauri v2, embedding the nikcli web UI in a platform-native shell.",
  },
  {
    name: "@nikcli-ai/enterprise",
    path: "packages/enterprise",
    role: "SolidStart web application for enterprise deployments, providing a browser-based interface for managing nikcli teams and sessions.",
  },
  {
    name: "@nikcli-ai/slack",
    path: "packages/slack",
    role: "Cloudflare Worker that connects a Slack workspace to a running nikcli server, supporting text and voice-message sessions.",
  },
  {
    name: "@nikcli-ai/ui",
    path: "packages/ui",
    role: "Shared SolidJS component library (buttons, accordions, avatars, tool views) used by the app, enterprise, and desktop packages.",
  },
  {
    name: "@nikcli-ai/util",
    path: "packages/util",
    role: "Lightweight utility helpers (array, binary, encoding, error, function) shared across workspace packages.",
  },
  {
    name: "@nikcli-ai/function",
    path: "packages/function",
    role: "Minimal Hono-based HTTP function package providing a stub API entrypoint.",
  },
  {
    name: "@opentui/webrenderer",
    path: "packages/webrenderer",
    role: "OpenTUI web-view renderer that bridges native browser runtime, WebViewController, and SolidJS bindings for embedded web views inside the TUI.",
  },
  {
    name: "@nikcli-ai/app",
    path: "packages/app",
    role: "SolidJS single-page application shell used by desktop and companion, containing shared layout, context providers, and add-on entry points.",
  },
  {
    name: "@nikcli-ai/mobile",
    path: "packages/mobile",
    role: "React Native / Expo companion app for iOS and Android that streams sessions over SSE and handles mobile-specific permissions.",
  },
  {
    name: "@nikcli-ai/web",
    path: "packages/web",
    role: "Astro site that powers nikcli-ai.dev, the docs site, and the Studio dashboard.",
  },
  {
    name: "@nikcli-ai/computer-use",
    path: "packages/computer-use",
    role: "Headless desktop-automation engine: daemon, sandbox/host backends, recording pipeline, PR-ready evidence bundles. Sibling of browser-control and terminal-control.",
  },
  {
    name: "@nikcli-ai/browser-control",
    path: "packages/browser-control",
    role: "Headless browser-automation engine for Chromium pages: per-workspace daemon, recording pipeline, evidence bundles. Powers the browser tool.",
  },
  {
    name: "@nikcli-ai/terminal-control",
    path: "packages/terminal-control",
    role: "Terminal-recording engine with native termctrl driver: .termctrl recordings, JSON/ANSI/PNG/SVG/video renderers, evidence bundles.",
  },
  {
    name: "@nikcli-ai/tui-image",
    path: "packages/tui-image",
    role: "Image rendering primitives for TUI / OpenTUI terminals with Kitty, Sixel, iTerm2 and Unicode fallbacks.",
  },
  {
    name: "@nikcli-ai/sdk-next",
    path: "packages/sdk-next",
    role: "Next-generation JavaScript SDK prototype. Lives next to @nikcli-ai/sdk; see that package for the stable surface.",
