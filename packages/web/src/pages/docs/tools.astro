---
export const prerender = true

import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCard from "../../components/docs/DocCard.astro";
import DocCallout from "../../components/docs/DocCallout.astro";
import DocRelated from "../../components/docs/DocRelated.astro";

const related = [
  { title: "Agents", href: "/docs/agents", description: "Which agents can call which tools." },
  { title: "Permissions", href: "/docs/permissions", description: "Tool execution approval rules." },
  { title: "Plugins & Skills", href: "/docs/plugins", description: "Custom tools from plugins and skills." },
];

const toc = [
  { title: "Tool Registry", href: "#tool-registry", depth: 2 },
  { title: "Files & Search", href: "#files-search", depth: 2 },
  { title: "Orchestration", href: "#orchestration", depth: 2 },
  { title: "Context & Memory", href: "#context-memory", depth: 2 },
  { title: "Integrations & Media", href: "#integrations-media", depth: 2 },
  { title: "Full Tool Index", href: "#full-tool-index", depth: 2 },
];

const toolIndex = [
  { id: "question", file: "src/tool/question.ts", desc: "Ask the user a structured question." },
  { id: "bash", file: "src/tool/bash.ts", desc: "Run shell commands." },
  { id: "monitor", file: "src/tool/monitor.ts", desc: "Run long-lived shell commands in the background." },
  { id: "read", file: "src/tool/read.ts", desc: "Read file contents." },
  { id: "tree", file: "src/tool/tree.ts", desc: "Show a directory tree." },
  { id: "glob", file: "src/tool/glob.ts", desc: "Find files by glob pattern." },
  { id: "grep", file: "src/tool/grep.ts", desc: "Search file contents with regex." },
  { id: "edit", file: "src/tool/edit.ts", desc: "Apply exact in-place text edits." },
  { id: "write", file: "src/tool/write.ts", desc: "Write or overwrite files." },
  { id: "task", file: "src/tool/task.ts", desc: "Launch a delegated subagent." },
  { id: "delegation", file: "src/tool/delegation.ts", desc: "Inspect or control background delegations." },
  { id: "delegator", file: "src/tool/delegator.ts", desc: "Monitor and supervise background delegation jobs." },
  { id: "code_mode", file: "src/tool/code_mode.ts", desc: "Run an orchestration script in a confined interpreter that calls other tools programmatically, keeping intermediate results out of the context window." },
  { id: "context_collect", file: "src/tool/context_collect.ts", desc: "Collect workspace context from files." },
  { id: "context_related", file: "src/tool/context_related.ts", desc: "List files related to an entry file." },
  { id: "context_diagnostics", file: "src/tool/context_diagnostics.ts", desc: "List LSP diagnostics." },
  { id: "memory_search", file: "src/tool/memory_search.ts", desc: "Search past session memory." },
  { id: "generate_image", file: "src/tool/generate_image.ts", desc: "Generate images from prompts." },
  { id: "webfetch", file: "src/tool/webfetch.ts", desc: "Fetch and convert URL content." },
  { id: "todowrite", file: "src/tool/todo.ts", desc: "Write the session todo list." },
  { id: "todoread", file: "src/tool/todo.ts", desc: "Read the current todo list." },
  { id: "websearch", file: "src/tool/websearch.ts", desc: "Search the web via Exa when enabled." },
  { id: "codesearch", file: "src/tool/codesearch.ts", desc: "Search code via Exa when enabled." },
  { id: "skill", file: "src/tool/skill.ts", desc: "Load a skill definition." },
  { id: "apply_patch", file: "src/tool/apply_patch.ts", desc: "Patch files with structured diffs." },
  { id: "speak", file: "src/tool/speak.ts", desc: "Convert text to speech and play audio." },
  { id: "opentui", file: "src/tool/opentui.ts", desc: "Render terminal dashboards and rich visualizations." },
  { id: "artifact", file: "src/tool/artifact.ts", desc: "Publish a local file as a hosted page on nikcli.store, openable in a browser or the mobile app." },
  { id: "lsp", file: "src/tool/lsp.ts", desc: "LSP tool exposed behind experimental flags." },
  { id: "batch", file: "src/tool/batch.ts", desc: "Batch tool calls behind experimental flags." },
  { id: "plan_enter", file: "src/tool/plan.ts", desc: "Enter plan mode." },
  { id: "plan_exit", file: "src/tool/plan.ts", desc: "Exit plan mode." },
  { id: "advisor", file: "src/tool/advisor.ts", desc: "Receive background strategic guidance." },
  { id: "repo_clone", file: "src/tool/repo_clone.ts", desc: "Clone or update a Git repository into the managed repos directory." },
  { id: "repo_overview", file: "src/tool/repo_overview.ts", desc: "Produce a high-level overview of a managed repository clone." },
  { id: "search_tools", file: "src/tool/search_tools.ts", desc: "Search the tool registry by keyword to discover available tool IDs." },
  { id: "exec_code", file: "src/tool/exec_code.ts", desc: "Execute JavaScript/TypeScript code with tool globals available as async functions." },
  { id: "create_goal", file: "src/tool/goal.ts", desc: "Create a session goal with an objective and optional token budget." },
  { id: "get_goal", file: "src/tool/goal.ts", desc: "Read the current goal state for this session." },
  { id: "update_goal", file: "src/tool/goal.ts", desc: "Mark the session goal as complete or blocked." },
  { id: "invalid", file: "src/tool/invalid.ts", desc: "Rejected invalid tool-call shape." },
  { id: "computer", file: "src/tool/computer.ts", desc: "Computer-use tool: capture screenshots, send mouse and keyboard input to a desktop session." },
  { id: "browser_control", file: "src/tool/browser-control.ts", desc: "Drive a browser: navigate, snapshot, click, type, and capture the action log." },
];
---

<DocsLayout
  title="Tools"
  subtitle="Public tools registered in packages/nikcli/src/tool/registry.ts plus tool-gating behavior."
  description="Reference for nikcli public tools, tool registry, permissions, model gating, and agent tool access."
  toc={toc}
>
  <section id="tool-registry" class="doc-section">
    <h2>Tool Registry</h2>
    <p>
      Tools are registered in <code>packages/nikcli/src/tool/registry.ts</code>. The registry filters
      them based on model capabilities, client type, and experimental flags.
    </p>
    <DocCallout type="info" title="Gating">
      <p>
        Some GPT-family models use <code>apply_patch</code> instead of <code>edit</code> and
        <code>write</code>. <code>websearch</code> and <code>codesearch</code> require provider or env
        setup. <code>lsp</code> needs <code>NIKCLI_EXPERIMENTAL_LSP_TOOL</code>;
        <code>batch</code> needs <code>experimental.batch_tool</code> in config;
        <code>plan_enter</code> / <code>plan_exit</code> need experimental plan mode on the CLI client.
        <code>question</code> is available on app, CLI, and desktop clients.
      </p>
    </DocCallout>
    <DocCallout type="info" title="Permission modes override this surface">
      <p>
        The active <a href="/docs/permissions#modes">permission mode</a>
        (<code>require_approval</code> / <code>approve_for_me</code> / <code>full_access</code> /
        <code>custom</code>) is layered on top of the registry: even when a tool is registered
        here, the mode decides whether it runs without prompting, prompts the user, or is denied.
        The TUI command palette exposes a <code>Permissions</code> dialog to switch modes.
      </p>
    </DocCallout>
  </section>

  <section id="files-search" class="doc-section">
    <h2>Files & Search</h2>
    <div class="doc-grid not-prose">
      <DocCard title="read / tree / glob / grep" eyebrow="Discovery">
        <p>Read files, inspect directory structure, and search local content quickly.</p>
      </DocCard>
      <DocCard title="edit / write / apply_patch" eyebrow="Editing">
        <p>Perform in-place edits, full writes, or structured patch-based updates.</p>
      </DocCard>
      <DocCard title="webfetch / websearch / codesearch" eyebrow="External lookup">
        <p>Fetch web pages and optionally search the web or remote code indexes when enabled.</p>
      </DocCard>
    </div>
  </section>

  <section id="orchestration" class="doc-section">
    <h2>Orchestration</h2>
    <div class="doc-grid not-prose">
      <DocCard title="bash / monitor" eyebrow="Execution">
        <p>Run shell commands directly or keep them alive in the background with persisted logs.</p>
      </DocCard>
      <DocCard title="task / delegation / delegator" eyebrow="Subagents">
        <p>Launch delegated agents, inspect or cancel them, and supervise background jobs.</p>
      </DocCard>
      <DocCard title="todowrite / todoread" eyebrow="Task tracking">
        <p>Track structured task state inside a session and surface progress to the user.</p>
      </DocCard>
      <DocCard title="advisor" eyebrow="Guidance">
        <p>Request background strategic advice from an advisor agent when available.</p>
      </DocCard>
      <DocCard title="opentui" eyebrow="Visualization">
        <p>Render tables, charts, timelines, and progress widgets directly in the terminal UI.</p>
      </DocCard>
    </div>
  </section>

  <section id="context-memory" class="doc-section">
    <h2>Context & Memory</h2>
    <div class="doc-grid not-prose">
      <DocCard title="context_* / memory_search" eyebrow="Workspace context">
        <p>Collect repo context, related files, diagnostics, and prior-session memory.</p>
      </DocCard>
      <DocCard title="repo_clone / repo_overview" eyebrow="External repositories">
        <p>Clone or refresh a remote repository into the managed repos directory, then produce a high-level overview of its structure.</p>
      </DocCard>
      <DocCard title="create_goal / get_goal / update_goal" eyebrow="Session goals">
        <p>Create a verifiable session goal with an optional token budget, read its current state, and mark it complete or blocked.</p>
      </DocCard>
      <DocCard title="search_tools" eyebrow="Discovery">
        <p>Search the live tool registry by keyword to discover which tool IDs are available in the current session.</p>
      </DocCard>
      <DocCard title="exec_code" eyebrow="Code execution">
        <p>Execute JavaScript/TypeScript code with all registered tools available as async globals, up to a configurable timeout.</p>
      </DocCard>
    </div>
  </section>

  <section id="integrations-media" class="doc-section">
    <h2>Integrations & Media</h2>
    <div class="doc-grid not-prose">
      <DocCard title="generate_image / speak" eyebrow="Generative media">
        <p>Create images and play text-to-speech output using the configured providers.</p>
      </DocCard>
      <DocCard title="skill" eyebrow="Instruction packs">
        <p>Load a skill to bring focused instructions into the current session.</p>
      </DocCard>
      <DocCard title="browser_control" eyebrow="Browser automation">
        <p>Navigate, snapshot, click, type, and capture the action log of a browser session.</p>
      </DocCard>
      <DocCard title="computer" eyebrow="Computer use">
        <p>Capture screenshots and send mouse / keyboard input to a desktop session for computer-use workflows.</p>
      </DocCard>
    </div>
  </section>

  <section id="full-tool-index" class="doc-section">
    <h2>Full Tool Index</h2>
    <table class="doc-table">
      <thead>
        <tr>
          <th>Tool ID</th>
          <th>Description</th>
          <th>Source</th>
        </tr>
      </thead>
      <tbody>
        {toolIndex.map((tool) => (
          <tr>
            <td><code>{tool.id}</code></td>
            <td>{tool.desc}</td>
            <td><code>{tool.file}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <DocRelated links={related} />
</DocsLayout>
