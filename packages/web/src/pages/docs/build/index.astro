        <tr><td>TUI plugin contract</td><td><code>packages/plugin/src/tui.ts</code>, <code>src/v2/</code></td></tr>
        <tr><td>Plugin loading and hook dispatch</td><td><code>packages/nikcli/src/plugin/index.ts</code></td></tr>
        <tr><td>Generated HTTP client</td><td><code>packages/sdk/js/src/httpapi/</code></td></tr>
        <tr><td>Client generation</td><td><code>packages/nikcli/script/generate-httpapi-clients.ts</code></td></tr>
        <tr><td>Embedded host</td><td><code>packages/sdk-next/src/nikcli.ts</code></td></tr>
        <tr><td>Tool registry</td><td><code>packages/nikcli/src/tool/registry.ts</code></td></tr>
      </tbody>
    </table>
  </section>

