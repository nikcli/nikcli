---
export const prerender = true;

import DocsLayout from "../../../layouts/DocsLayout.astro";
import DocCallout from "../../../components/docs/DocCallout.astro";
import DocCode from "../../../components/docs/DocCode.astro";
import DocRelated from "../../../components/docs/DocRelated.astro";

const toc = [
  { title: "The shape of it", href: "#shape", depth: 2 },
  { title: "Subscribe first", href: "#subscribe", depth: 2 },
  { title: "Submit without waiting", href: "#submit", depth: 2 },
  { title: "Print the deltas", href: "#deltas", depth: 2 },
  { title: "Know when it is done", href: "#idle", depth: 2 },
  { title: "The whole thing", href: "#complete", depth: 2 },
  { title: "Useful events", href: "#events", depth: 2 },
