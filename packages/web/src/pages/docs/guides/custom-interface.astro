---
export const prerender = true;

import DocsLayout from "../../../layouts/DocsLayout.astro";
import DocCallout from "../../../components/docs/DocCallout.astro";
import DocCode from "../../../components/docs/DocCode.astro";
import DocRelated from "../../../components/docs/DocRelated.astro";

const toc = [
  { title: "What an interface owes the user", href: "#contract", depth: 2 },
  { title: "State from one feed", href: "#state", depth: 2 },
  { title: "Rendering parts", href: "#parts", depth: 2 },
  { title: "Permissions", href: "#permissions", depth: 2 },
  { title: "Questions", href: "#questions", depth: 2 },
  { title: "Todos and diffs", href: "#todos", depth: 2 },
  { title: "Reconnecting", href: "#reconnect", depth: 2 },
