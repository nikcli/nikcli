---
export const prerender = true

import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCard from "../../components/docs/DocCard.astro";
import DocCallout from "../../components/docs/DocCallout.astro";
import DocCode from "../../components/docs/DocCode.astro";

const toc = [
  { title: "Install & Run", href: "#install-run", depth: 2 },
  { title: "Architecture Snapshot", href: "#architecture-snapshot", depth: 2 },
  { title: "Platform Surfaces", href: "#platform-surfaces", depth: 2 },
  { title: "Codebase Roadmap", href: "#codebase-roadmap", depth: 2 },
  { title: "What's new", href: "#whats-new", depth: 2 },
  { title: "Next Steps", href: "#next-steps", depth: 2 },
];
---

<DocsLayout
  title="Getting Started"
  subtitle="A source-of-truth overview of nikcli across the CLI, server, connectors, and mobile app."
  description="nikcli getting started guide covering the CLI, TUI, session engine, server, connectors, and mobile app."
  toc={toc}
>
  <section id="install-run" class="doc-section">
    <h2>Install & Run</h2>
    <DocCallout type="info" title="nikcli is a fork of OpenCode">
      <p>
        nikcli is an independent fork of
        <a href="https://github.com/anomalyco/opencode" target="_blank" rel="noopener noreferrer">OpenCode</a>,
        the open source coding agent — full credit for the original project goes to its authors and
        contributors. nikcli is not affiliated with or endorsed by them, so please report anything
        you hit here on the
        <a href="https://github.com/nikcli/nikcli" target="_blank" rel="noopener noreferrer">nikcli repository</a>,
        never on the upstream tracker.
      </p>
    </DocCallout>
    <p>
      nikcli is a Bun-based coding agent with a terminal UI, HTTP server, connector system, a
      browser web app, a Studio dashboard, and a mobile companion app. It also runs autonomously
      toward verifiable goals, schedules and API-triggers <a href="/docs/routines">routines</a>, and
      localizes both its interface and the model's replies. The CLI entrypoint is
      <code>packages/nikcli/src/index.ts</code>.
    </p>
    <DocCode language="bash" title="Terminal · macOS / Linux">
      curl -fsSL https://nikcli-ai.dev/install | bash
    </DocCode>
    <DocCode language="powershell" title="PowerShell · Windows">
      irm https://nikcli-ai.dev/install.ps1 | iex
    </DocCode>
    <DocCode language="bash" title="Terminal">
      nikcli
    </DocCode>
    <DocCallout type="info" title="Install location">
      <p>
        Both installers drop the binary in <code>~/.nikcli/bin</code> and add it to your PATH — set
        <code>NIKCLI_INSTALL_DIR</code> to change that. On Windows the PowerShell installer also reads
        <code>NIKCLI_VERSION</code> to pin a version and <code>NIKCLI_NO_PATH=1</code> to leave PATH
        untouched. Any platform can also install from npm with <code>npm i -g nikcli-ai@latest</code>.
      </p>
    </DocCallout>
    <DocCallout type="info" title="Runtime">
      <p>
        For local development in this repo, run <code>bun dev</code> inside
        <code>packages/nikcli</code>.
      </p>
    </DocCallout>
  </section>

  <section id="architecture-snapshot" class="doc-section">
    <h2>Architecture Snapshot</h2>
    <div class="doc-grid not-prose my-2">
      <DocCard title="CLI + TUI" eyebrow="Interface">
        <p>
          Commands are registered in <code>packages/nikcli/src/index.ts</code>. The default TUI and
          worker flow live in <code>packages/nikcli/src/cli/cmd/tui/</code>.
        </p>
      </DocCard>
      <DocCard title="Session Engine" eyebrow="Core">
        <p>
          Sessions, messages, tool parts, sharing, and todo state live under
          <code>packages/nikcli/src/session/</code>.
        </p>
      </DocCard>
      <DocCard title="Tools & Permissions" eyebrow="Execution">
        <p>
          The public tool surface is defined in <code>packages/nikcli/src/tool/registry.ts</code>
          and guarded by <code>packages/nikcli/src/permission/</code>.
        </p>
      </DocCard>
      <DocCard title="Server + API" eyebrow="Services">
        <p>
          HTTP and SSE endpoints for TUI, companion, connectors, and mobile are built in
          <code>packages/nikcli/src/server/</code>.
        </p>
      </DocCard>
      <DocCard title="Connectors" eyebrow="Automation">
        <p>
          External service connectors and auth live under
          <code>packages/nikcli/src/connectors/</code>.
        </p>
      </DocCard>
      <DocCard title="Mobile App" eyebrow="Companion">
        <p>
          The Expo app in <code>packages/mobile</code> streams sessions, approvals, tool output,
          GitHub worktrees, and notifications from the host server.
        </p>
      </DocCard>
    </div>
  </section>

  <section id="platform-surfaces" class="doc-section">
    <h2>Platform Surfaces</h2>
    <div class="doc-grid not-prose my-2">
      <DocCard title="CLI Reference" eyebrow="Commands" href="/docs/cli">
        <p>
          Covers the default TUI flow plus <code>goal</code>, <code>routine</code>, <code>serve</code>,
          <code>remote</code>, <code>companion</code>, <code>mobile</code>, <code>connectors</code>,
          model, locale, and diagnostics commands.
        </p>
      </DocCard>
      <DocCard title="Web App & Studio" eyebrow="Browser" href="/docs/web-app">
        <p>
          Drive sessions from the browser via <code>nikcli web</code> and the <code>/app</code> SPA,
          or manage agents, sessions, MCP, and config from the <code>/dashboard</code> Studio.
        </p>
      </DocCard>
      <DocCard title="Mobile" eyebrow="Host + app" href="/docs/mobile">
        <p>
          Documents host pairing, session streaming, approvals, notifications, offline retry, and
          the Tophat config feature.
        </p>
      </DocCard>
      <DocCard title="Guides" eyebrow="Walkthroughs" href="/docs/guides">
        <p>
          Step-by-step: write a plugin from an empty file, copy from eight plugin recipes, drive the
          HTTP API with curl or the SDK, and stream a response as it is produced.
        </p>
      </DocCard>
      <DocCard title="Build" eyebrow="Extend" href="/docs/build">
        <p>
          Plugins that run inside the agent, the typed client that drives a running server, and the
          embedded host that runs nikcli in your own process.
        </p>
      </DocCard>
      <DocCard title="API Reference" eyebrow="HTTP" href="/docs/api">
        <p>
          Every endpoint the server exposes, generated from its OpenAPI document: base URL, the
          authentication schemes, instance selection, streaming feeds, and all 346 operations
          grouped by resource.
        </p>
      </DocCard>
      <DocCard title="Packages & Suite" eyebrow="Monorepo" href="/docs/packages">
        <p>
          <code>packages/nikcli</code> is the base; supporting packages include
          <code>@nikcli-ai/llm</code>, <code>http-recorder</code>, the SDK, mobile, and web.
        </p>
      </DocCard>
    </div>
  </section>

  <section id="codebase-roadmap" class="doc-section">
    <h2>Codebase Roadmap</h2>
    <p>
      The runtime surface is split across three main packages: <code>packages/nikcli</code> for the
      CLI and server, <code>packages/mobile</code> for the Expo app, and <code>packages/web</code>
      for this documentation site.
    </p>
    <div class="doc-grid not-prose my-2">
      <DocCard title="Core runtime" eyebrow="packages/nikcli" href="/docs/architecture">
        <p>
          Commands, agents, sessions, tools, connectors, sharing, storage, sync, and HTTP routes.
        </p>
      </DocCard>
      <DocCard title="Supporting surfaces" eyebrow="packages/mobile + packages/web" href="/docs/mobile">
        <p>
          Mobile session control, teleport, session artifacts, workspace switcher, and the docs
          experience itself.
        </p>
      </DocCard>
    </div>
  </section>

  <section id="whats-new" class="doc-section">
    <h2>What's new</h2>
    <p>
      Recent releases added the <a href="/docs/sync">sync subsystem</a> (event journal, projections,
      idempotent outbox, remote hub), the macOS <a href="/docs/island">Island plugin</a>
      (notch UI), new TUI feature plugins (<a href="/docs/brain">Brain</a>, Browser, ChatBot,
      <a href="/docs/computer-use">Computer</a>, DeepSec, Observability), and several mobile
      sheets (teleport, session artifacts, workspace switcher). The most recent release also
      extracted three sibling automation engines — <a href="/docs/computer-use">computer-use</a>,
      <a href="/docs/browser-control">browser-control</a>, and
      <a href="/docs/terminal-control">terminal-control</a> — out of <code>packages/nikcli</code>
      into first-class workspace packages. The brand wordmarks are now shared between web and
      mobile — see the <a href="/docs/brand">brand assets</a> reference.
    </p>
    <div class="doc-grid not-prose my-2">
      <DocCard title="Computer-use engine" eyebrow="New package" href="/docs/computer-use">
        <p>
          <code>@nikcli-ai/computer-use</code>: headless desktop-automation daemon, sandbox/host
          backends, recording pipeline, PR-ready evidence bundles. Sibling of browser-control
          and terminal-control.
        </p>
      </DocCard>
      <DocCard title="Browser-control engine" eyebrow="New package" href="/docs/browser-control">
        <p>
          <code>@nikcli-ai/browser-control</code>: per-workspace Chromium daemon with the same
          CLI grammar and bundle format as computer-use and terminal-control.
        </p>
      </DocCard>
      <DocCard title="Terminal-control engine" eyebrow="New package" href="/docs/terminal-control">
        <p>
          <code>@nikcli-ai/terminal-control</code>: native termctrl driver, <code>.termctrl</code>
          recordings, ANSI/JSON/PNG/SVG/video renderers, evidence bundles.
        </p>
      </DocCard>
      <DocCard title="Brain subsystem" eyebrow="Long-term memory" href="/docs/brain">
        <p>
          Hourly scheduler, model picker, configurable consolidation session, and the
          <code>memory.instruction.md</code> file under
          <code>.github/instructions/</code>.
        </p>
      </DocCard>
      <DocCard title="Island plugin" eyebrow="macOS notch" href="/docs/island">
        <p>
          <code>NikcliIsland.app</code> and the bridge that mirrors session state into the file
          contract it reads. Bidirectional: the notch can answer permission requests via
          <code>POST /permission/:requestID/reply</code>.
        </p>
      </DocCard>
      <DocCard title="Sync subsystem" eyebrow="Opt-in hub" href="/docs/sync">
        <p>Local event log, typed projections, cold-start snapshots, idempotent outbox, remote hub transport.</p>
      </DocCard>
      <DocCard title="New TUI feature plugins" eyebrow="TUI surface" href="/docs/tui">
        <p>
          Brain (model + scheduler), Browser (computer-use), ChatBot (Slack / Discord / Teams
          / GChat / Linear / GitHub webhooks), Computer, DeepSec, and Observability are now
          first-class TUI plugins.
        </p>
      </DocCard>
      <DocCard title="Teleport and artifacts" eyebrow="Mobile" href="/docs/mobile">
        <p>
          <code>nikcli teleport</code> ships a session (and optionally the working tree) to a
          remote host, the mobile app exposes a teleport sheet, and session artifact viewer
          surfaces URLs, HTML, SVG, and Mermaid previews inline.
        </p>
      </DocCard>
      <DocCard title="Workspace switcher" eyebrow="Mobile" href="/docs/mobile">
        <p>
          The mobile app can browse workspaces from the host, swap the active directory, and
          deep-link into the right session in one tap.
        </p>
      </DocCard>
      <DocCard title="Shared wordmark" eyebrow="Brand" href="/docs/brand">
        <p>
          Three PNG variants are now used consistently across the docs navbar, footer, dashboard
          connect screen, and mobile app via a single source of truth in
          <code>packages/mobile/assets/</code>.
        </p>
      </DocCard>
      <DocCard title="Permission modes" eyebrow="TUI surface" href="/docs/permissions#modes">
        <p>
          The TUI command palette now exposes a <strong>Permissions</strong> dialog with three presets —
          <code>require_approval</code>, <code>approve_for_me</code> (default), and <code>full_access</code> —
          that write the per-agent <code>permission</code> map. A <code>custom</code> state surfaces
          when an individual tool is changed by hand.
        </p>
      </DocCard>
    </div>
  </section>

  <section id="next-steps" class="doc-section">
    <h2>Next Steps</h2>
    <DocCallout type="success" title="Ready to roll">
      <p>
        Start with <a href="/docs/cli">CLI Reference</a>, then configure providers and connectors
        in <a href="/docs/configuration">Configuration</a>.
      </p>
    </DocCallout>
  </section>
</DocsLayout>
