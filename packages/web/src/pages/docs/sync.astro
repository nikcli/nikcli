---
export const prerender = true

import DocsLayout from "../../layouts/DocsLayout.astro";
import DocCallout from "../../components/docs/DocCallout.astro";
import DocCode from "../../components/docs/DocCode.astro";
import DocCard from "../../components/docs/DocCard.astro";

const toc = [
  { title: "Overview", href: "#overview", depth: 2 },
  { title: "What gets synced", href: "#what-syncs", depth: 2 },
  { title: "Event log", href: "#event-log", depth: 2 },
  { title: "Projections and snapshots", href: "#projections", depth: 2 },
  { title: "Outbox and idempotency", href: "#outbox", depth: 2 },
  { title: "Remote transport", href: "#transport", depth: 2 },
  { title: "CLI command", href: "#cli", depth: 2 },
  { title: "TUI sync dialog", href: "#tui-dialog", depth: 2 },
