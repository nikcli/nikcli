---
import "../../styles/global.css"
import { OAuthCallback } from "@/dashboard/components/OAuthCallback"
import ThemeIcons from "../../components/ThemeIcons.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Completing sign-in | nikcli</title>
    <ThemeIcons />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-terminal-bg font-sans">
    <main class="rounded-[var(--radius-md)] border border-terminal-border bg-terminal-panel px-8 py-6">
      <OAuthCallback client:load />
    </main>
  </body>
</html>
