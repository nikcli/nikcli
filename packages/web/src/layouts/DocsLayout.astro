---
import "../styles/global.css";
import "../styles/docs.css";
import "../styles/brand.css";
import Navbar from "../components/Navbar.astro";
import DocToc from "../components/docs/DocToc.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import DocsSubnav from "../components/docs/DocsSubnav.astro";
import DocAiActions from "../components/docs/DocAiActions.astro";
import DocAssistant from "../components/docs/DocAssistant.astro";
import { ClientRouter } from 'astro:transitions';

import SocialMeta from "../components/SocialMeta.astro";

interface Props {
  title?: string;
  subtitle?: string;
  toc?: { title: string; href: string; depth?: number }[];
  description?: string;
}

const { 
  title = "Documentation", 
  subtitle, 
  toc = [],
  description = "Official documentation for Nikcli. Learn how to install, configure, and use the terminal-native AI development agent."
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    
    <!-- SEO & Metadata -->
    <title>{title} - Nikcli Docs</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nikcli" />
    <meta name="keywords" content="nikcli, ai agent, development agent, terminal, cli, lsp, mcp, open source, documentation" />
    
    <SocialMeta title={`${title} - Nikcli Docs`} description={description} />
    <link rel="alternate" type="text/markdown" href={`/.llm?path=${encodeURIComponent(pathname)}`} title={`${title} as Markdown`} />

    <!-- Fonts: Syne (display) + Figtree (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" />

    <ClientRouter />
    <script is:inline>
      const initTheme = () => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored || (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      };
      initTheme();
      document.addEventListener('astro:after-swap', initTheme);
    </script>
  </head>
  <body class="bg-terminal-bg text-terminal-text antialiased font-sans min-h-screen flex flex-col">
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[100] px-5 py-2.5 bg-terminal-text text-terminal-bg font-semibold rounded-lg shadow-xl" href="#main-content">Skip to content</a>
    <Navbar />
    <DocsSubnav />

    <div class="page-shell relative flex w-full flex-1 min-h-0 flex-col xl:flex-row">

      <!-- Mobile Docs Menu Toggle -->
       <div class="sticky top-[calc(var(--topbar-height)+var(--docs-subnav-height))] z-40 flex min-h-[var(--docs-mobilebar-height)] items-center justify-between border-b border-terminal-border/60 bg-terminal-bg/90 px-0 py-3 shadow-sm backdrop-blur-xl dark:border-white/5 dark:bg-terminal-bg/80 xl:hidden">
          <span class="text-sm font-semibold text-terminal-text">Docs</span>
          <button id="mobile-docs-toggle" type="button" class="inline-flex items-center gap-2 rounded-full border border-terminal-border/60 bg-terminal-panel/90 px-3 py-2 text-sm font-semibold text-terminal-text shadow-sm transition-[background-color,transform] duration-150 ease-out hover:bg-surface-hover active:scale-[0.97]" aria-label="Open docs navigation" aria-controls="docs-sidebar" aria-expanded="false">
           <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h6M4 12h6M4 18h6M14 5h6v14h-6z"></path></svg>
           <span>Browse</span>
         </button>
       </div>

      <!-- Sidebar Navigation -->
      <DocsSidebar />

      <!-- Main Content Area -->
      <main id="main-content" class="min-w-0 flex-1 py-8 pb-24 outline-none sm:py-10 lg:py-14 lg:pb-28 xl:px-10" tabindex="-1">
        <article data-llm-document class="prose mx-auto max-w-[48rem] prose-pre:border prose-pre:border-terminal-window-border prose-pre:bg-terminal-window-code prose-pre:shadow-sm prose-p:leading-relaxed prose-headings:font-bold prose-headings:tracking-tight prose-a:underline-offset-4 prose-a:decoration-terminal-border prose-a:transition-colors hover:prose-a:text-terminal-accent hover:prose-a:decoration-terminal-accent">
          <header class="not-prose mb-10 border-b border-terminal-border/60 pb-8 sm:mb-12 sm:pb-10">
             <div data-llm-exclude class="mb-5 inline-flex items-center gap-2 rounded-md border border-terminal-accent/20 bg-terminal-accent/10 px-2.5 py-1 font-mono text-eyebrow uppercase text-terminal-accent">
               <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
               Documentation
             </div>
              <h1 class="mb-5 text-page-title text-terminal-text sm:mb-6">{title}</h1>
              {subtitle && <p class="max-w-2xl text-page-subtitle text-terminal-muted">{subtitle}</p>}
              <DocAiActions pathname={pathname} />
          </header>
          <div class="content-body text-terminal-text font-sans relative z-10">
             <slot />
          </div>
        </article>
      </main>

      <!-- Table of Contents (Right Sidebar) -->
      {toc.length > 0 && (
        <div class="hidden xl:block w-72 shrink-0 pl-6 self-start">
          <div class="sticky top-[calc(var(--topbar-height)+var(--docs-subnav-height))] max-h-[calc(100vh-var(--topbar-height)-var(--docs-subnav-height))] overflow-y-auto pt-12 pb-24 custom-scrollbar">
             <DocToc items={toc} />
          </div>
        </div>
      )}
    </div>

    <DocAssistant pathname={pathname} />

    <footer class="border-t border-terminal-border/50 bg-terminal-panel/50 py-8 sm:py-10 mt-auto">
      <div class="page-shell flex flex-col items-center justify-between gap-5 sm:flex-row">
        <div class="flex items-center gap-2.5">
          <img
            src="/brand/wordmark-light.png"
            alt="nikcli"
            width="79"
            height="26"
            loading="lazy"
            decoding="async"
            class="h-5 w-auto dark:hidden"
          />
          <img
            src="/brand/wordmark-dark.png"
            alt="nikcli"
            width="79"
            height="26"
            loading="lazy"
            decoding="async"
            class="h-5 w-auto hidden dark:block"
          />
          <span class="text-[13px] font-medium text-terminal-muted">
            &copy; {new Date().getFullYear()}. MIT License. A fork of <a href="https://github.com/anomalyco/opencode" class="hover:text-terminal-text transition-colors duration-100 underline underline-offset-2" rel="noreferrer" target="_blank">OpenCode</a>.
          </span>
        </div>
        <nav class="flex gap-5" aria-label="Footer">
          <a href="https://github.com/nikomatt69/nikcli" class="text-[13px] font-medium text-terminal-muted hover:text-terminal-text transition-colors duration-100" rel="noreferrer" target="_blank">GitHub</a>
          <a href="/docs" class="text-[13px] font-medium text-terminal-muted hover:text-terminal-text transition-colors duration-100">Docs</a>
          <a href="/dashboard" class="text-[13px] font-medium text-terminal-muted hover:text-terminal-text transition-colors duration-100">Studio</a>
          <a href="/app" class="text-[13px] font-medium text-terminal-muted hover:text-terminal-text transition-colors duration-100">Web App</a>
        </nav>
      </div>
    </footer>

    <script>
      const initDocs = async () => {
        if (typeof window === 'undefined') return;
        (window as Window & { __nikcliDocsCleanup?: () => void }).__nikcliDocsCleanup?.();

        const cleanups: Array<() => void> = [];
        const mobileBtn = document.getElementById('mobile-docs-toggle');
        const sidebar = document.getElementById('docs-sidebar');
        const mobileSidebarClasses = [
          'fixed',
          'inset-x-[var(--page-gutter)]',
          'top-[calc(var(--topbar-height)+var(--docs-subnav-height)+var(--docs-mobilebar-height)+0.5rem)]',
          'z-50',
          'block',
          'h-[calc(100dvh-var(--topbar-height)-var(--docs-subnav-height)-var(--docs-mobilebar-height)-1rem)]',
          'overflow-y-auto',
          'rounded-[var(--radius-card)]',
          'border',
          'border-terminal-border/80',
          'bg-terminal-panel/95',
          'px-4',
          'pb-[max(1rem,env(safe-area-inset-bottom))]',
          'shadow-2xl',
          'backdrop-blur-xl',
        ];

        const docsBtn = mobileBtn;
        let sidebarOpen = false;

        const renderButton = (open: boolean) => {
          if (!docsBtn) return;
          docsBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          docsBtn.setAttribute('aria-label', open ? 'Close docs navigation' : 'Open docs navigation');
          docsBtn.innerHTML = open
            ? `<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg><span>Close</span>`
            : `<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h6M4 12h6M4 18h6M14 5h6v14h-6z"></path></svg><span>Browse</span>`;
        };

        const closeSidebar = () => {
          sidebarOpen = false;
          sidebar?.classList.add('hidden');
          sidebar?.classList.remove(...mobileSidebarClasses);
          document.body.style.overflow = '';
          renderButton(false);
        };

        const openSidebar = () => {
          sidebarOpen = true;
          sidebar?.classList.remove('hidden');
          sidebar?.classList.add(...mobileSidebarClasses);
          document.body.style.overflow = 'hidden';
          renderButton(true);
          window.dispatchEvent(new CustomEvent('nikcli:mobile-overlay-open', { detail: { source: 'docs' } }));
        };

        renderButton(false);

        const handleToggle = () => {
          if (sidebarOpen) closeSidebar();
          else openSidebar();
        };

        docsBtn?.addEventListener('click', handleToggle);
        cleanups.push(() => docsBtn?.removeEventListener('click', handleToggle));

        const handleExternalOpen = (event: Event) => {
          if (!(event instanceof CustomEvent) || event.detail?.source === 'docs') return;
          closeSidebar();
        };
        window.addEventListener('nikcli:mobile-overlay-open', handleExternalOpen);
        cleanups.push(() => window.removeEventListener('nikcli:mobile-overlay-open', handleExternalOpen));

        const handleEscape = (event: KeyboardEvent) => {
          if (event.key === 'Escape') closeSidebar();
        };
        window.addEventListener('keydown', handleEscape);
        cleanups.push(() => window.removeEventListener('keydown', handleEscape));

        const handleBreakpoint = (event: MediaQueryListEvent) => {
          if (event.matches) closeSidebar();
        };
        const desktopQuery = window.matchMedia('(min-width: 1280px)');
        desktopQuery.addEventListener?.('change', handleBreakpoint);
        cleanups.push(() => desktopQuery.removeEventListener?.('change', handleBreakpoint));

        const handleBeforeSwap = () => closeSidebar();
        document.addEventListener('astro:before-swap', handleBeforeSwap);
        cleanups.push(() => document.removeEventListener('astro:before-swap', handleBeforeSwap));

        sidebar?.querySelectorAll('[data-mobile-docs-link]').forEach((link) => {
          link.addEventListener('click', closeSidebar);
          cleanups.push(() => link.removeEventListener('click', closeSidebar));
        });

        const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.doc-toc-link'));
        const sections = tocLinks
          .map((link) => document.querySelector(link.getAttribute('href') ?? ''))
          .filter((section): section is Element => section instanceof Element);

        if ('IntersectionObserver' in window && tocLinks.length > 0 && sections.length > 0) {
          const tocObserver = new IntersectionObserver(
            (entries) => {
              const visible = entries
                .filter((entry) => entry.isIntersecting)
                .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
              if (!visible) return;

              tocLinks.forEach((link) => {
                const isActive = link.getAttribute('href') === `#${visible.target.id}`;
                link.classList.toggle('active', isActive);
                if (isActive) {
                  link.setAttribute('aria-current', 'location');
                } else {
                  link.removeAttribute('aria-current');
                }
              });
            },
            {
              rootMargin: '-24% 0px -62% 0px',
              threshold: [0, 0.15, 0.35, 0.6],
            }
          );

          sections.forEach((section) => tocObserver.observe(section));
          cleanups.push(() => tocObserver.disconnect());
        }

        (window as Window & { __nikcliDocsCleanup?: () => void }).__nikcliDocsCleanup = () => {
          closeSidebar();
          cleanups.forEach((cleanup) => cleanup());
        };
      };

      const win = window as Window & { __nikcliDocsPageLoad?: () => void };
      if (win.__nikcliDocsPageLoad) {
        document.removeEventListener('astro:page-load', win.__nikcliDocsPageLoad);
      }
      win.__nikcliDocsPageLoad = () => initDocs();

      initDocs();
      document.addEventListener('astro:page-load', win.__nikcliDocsPageLoad);
    </script>
  </body>
</html>
