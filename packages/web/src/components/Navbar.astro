---
const navItems = [
  { href: "/download", label: "Download" },
  { href: "/app", label: "Web App" },
  { href: "/docs", label: "Docs" },
  { href: "/data", label: "Data" },
  { href: "/dashboard", label: "Studio" },
  { href: "https://github.com/nikcli/nikcli", label: "GitHub", icon: "github", external: true },
];
const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 w-full"
  aria-label="Primary navigation"
>
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-terminal-bg/80 backdrop-blur-xl border-b border-terminal-border/50 -z-10"></div>

  <div class="page-shell flex h-[var(--topbar-height)] items-center justify-between gap-4">

    <!-- Logo -->
    <a
      href="/"
      class="group flex items-center shrink-0 transition-opacity duration-150 ease-out hover:opacity-90 active:opacity-80"
      aria-label="nikcli home"
    >
      <img
        src="/brand/wordmark-light.png"
        alt="nikcli"
        width="158"
        height="52"
        loading="eager"
        decoding="async"
        class="h-8 w-auto dark:hidden transition-opacity duration-150"
      />
      <img
        src="/brand/wordmark-dark.png"
        alt="nikcli"
        width="158"
        height="52"
        loading="eager"
        decoding="async"
        class="h-8 w-auto hidden dark:block transition-opacity duration-150"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main">
      <!-- Nav links pill container -->
      <div class="flex items-center rounded-xl border border-terminal-border/40 bg-terminal-bg/60 p-[3px] shadow-soft">
        {navItems.map((item) => {
          const isActive = !item.external && pathname.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={[
                "relative px-3.5 py-[6px] rounded-[9px] text-[13px] font-semibold transition-[background-color,color,box-shadow,transform] duration-150 ease-out",
                isActive
                  ? "bg-terminal-panel text-terminal-text shadow-soft ring-1 ring-terminal-border/50"
                  : "text-terminal-muted hover:text-terminal-text",
              ].join(" ")}
              aria-current={isActive ? "page" : undefined}
              aria-label={item.icon === "github" ? "GitHub" : undefined}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noreferrer" : undefined}
            >
              {isActive && (
                <span
                  class="absolute inset-x-3 -top-[3px] h-[2px] rounded-full bg-terminal-accent"
                  aria-hidden="true"
                />
              )}
              {item.icon === "github" ? (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              ) : (
                <>
                  {item.label}
                  {item.external && (
                    <span class="ml-0.5 inline-block opacity-35 text-[10px]" aria-hidden="true">↗</span>
                  )}
                </>
              )}
            </a>
          );
        })}
      </div>

      <!-- Divider -->
      <div class="h-5 w-px bg-terminal-border/50 mx-2" aria-hidden="true" />

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-terminal-border/50 bg-terminal-panel/70 text-terminal-muted transition-[background-color,border-color,color,transform] duration-150 ease-out hover:border-terminal-accent/40 hover:text-terminal-accent hover:bg-terminal-accent/8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terminal-accent focus-visible:ring-offset-1 active:scale-[0.97]"
        aria-label="Toggle theme"
        aria-pressed="false"
      >
        <span class="block dark:hidden" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
            <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M16.9 16.9l2.1 2.1M19.1 4.9l-2.1 2.1M7.1 16.9l-2.1 2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="hidden dark:block" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <path d="M20 14.5A7.5 7.5 0 1 1 9.5 4a6.2 6.2 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>

      <!-- Install CTA -->
      <a
        href="/docs#install-run"
        class="ml-1 inline-flex items-center justify-center gap-1.5 px-4 py-[7px] rounded-[9px] bg-terminal-accent text-terminal-bg text-[13px] font-bold tracking-[0.01em] transition-[transform,opacity,box-shadow] duration-150 ease-out hover:opacity-90 hover:-translate-y-px active:translate-y-0 active:scale-[0.97] shadow-[0_2px_12px_-2px_rgb(var(--terminal-accent)/0.5)]"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
        </svg>
        Install
      </a>
    </nav>

    <!-- Mobile menu toggle -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden flex h-9 w-9 items-center justify-center rounded-lg border border-terminal-border/50 bg-terminal-panel/70 text-terminal-muted -mr-1 transition-[background-color,color,transform] duration-150 ease-out hover:text-terminal-text active:scale-[0.97]"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg id="icon-hamburger" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden absolute top-full inset-x-0 z-50 border-b border-terminal-border bg-terminal-bg/96 backdrop-blur-xl shadow-strong px-[var(--page-gutter)] pt-3 pb-[max(1rem,env(safe-area-inset-bottom))]"
    aria-label="Mobile navigation"
  >
    <nav class="flex flex-col gap-1 mb-4">
      {navItems.map((item) => {
        const isActive = !item.external && pathname.startsWith(item.href);
        return (
          <a
            href={item.href}
            data-mobile-menu-link
            class={[
              "flex items-center justify-between px-3.5 py-3 rounded-xl text-[15px] font-semibold transition-colors duration-100",
              isActive
                ? "bg-terminal-accent/10 text-terminal-accent border border-terminal-accent/20"
                : "text-terminal-muted hover:text-terminal-text hover:bg-surface-hover",
            ].join(" ")}
            aria-label={item.icon === "github" ? "GitHub" : undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
          >
            {item.icon === "github" ? (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            ) : (
              <>
                {item.label}
                {item.external && (
                  <svg class="w-3.5 h-3.5 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </>
            )}
          </a>
        );
      })}
    </nav>

    <div class="border-t border-terminal-border/50 pt-3 flex items-center justify-between px-1">
      <span class="text-[13px] font-medium text-terminal-muted">Theme</span>
      <button
        id="theme-toggle-mobile"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-terminal-border/60 bg-terminal-panel text-terminal-muted active:scale-[0.97] transition-transform duration-150 ease-out"
        aria-label="Toggle theme"
      >
        <span class="block dark:hidden" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M16.9 16.9l2.1 2.1M19.1 4.9l-2.1 2.1M7.1 16.9l-2.1 2.1"/>
          </svg>
        </span>
        <span class="hidden dark:block" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 14.5A7.5 7.5 0 1 1 9.5 4a6.2 6.2 0 0 0 10.5 10.5Z" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>
    </div>

    <a
      href="/docs#install-run"
      data-mobile-menu-link
      class="mt-3 flex items-center justify-center gap-2 w-full py-3.5 rounded-xl bg-terminal-accent text-terminal-bg font-bold text-[15px] tracking-[0.01em] active:scale-[0.97] transition-transform duration-150 ease-out shadow-[0_2px_16px_-2px_rgb(var(--terminal-accent)/0.45)]"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
      </svg>
      Install nikcli
    </a>
  </div>
</header>

<script>
  const initNavbar = () => {
    const win = window as Window & {
      __nikcliNavbarCleanup?: () => void;
      __nikcliNavbarPageLoad?: () => void;
    };

    win.__nikcliNavbarCleanup?.();
    const cleanups: Array<() => void> = [];

    const root = document.documentElement;

    const resolveTheme = (): "light" | "dark" => {
      const stored = localStorage.getItem("theme");
      if (stored === "dark" || stored === "light") return stored;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    };

    const applyTheme = (theme: "light" | "dark") => {
      root.setAttribute("data-theme", theme);
      localStorage.setItem("theme", theme);
      document.querySelectorAll<HTMLElement>("#theme-toggle, #theme-toggle-mobile").forEach((el) => {
        el.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
      });
    };

    applyTheme(resolveTheme());

    const attachToggle = (id: string) => {
      const el = document.getElementById(id);
      if (!el || !el.parentNode) return;
      const clone = el.cloneNode(true) as HTMLElement;
      el.parentNode.replaceChild(clone, el);
      const handler = () => applyTheme(resolveTheme() === "dark" ? "light" : "dark");
      clone.addEventListener("click", handler);
      cleanups.push(() => clone.removeEventListener("click", handler));
    };

    attachToggle("theme-toggle");
    attachToggle("theme-toggle-mobile");

    // Mobile menu
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-hamburger");
    const iconClose = document.getElementById("icon-close");

    const newBtn = btn?.cloneNode(true) as HTMLElement | null;
    if (btn && newBtn && btn.parentNode) btn.parentNode.replaceChild(newBtn, btn);

    let menuOpen = false;

    const setMenuState = (open: boolean) => {
      menuOpen = open;
      menu?.classList.toggle("hidden", !open);
      document.body.style.overflow = open ? "hidden" : "";
      newBtn?.setAttribute("aria-expanded", open ? "true" : "false");
      newBtn?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.getElementById("icon-hamburger")?.classList.toggle("hidden", open);
      document.getElementById("icon-close")?.classList.toggle("hidden", !open);
      if (open) window.dispatchEvent(new CustomEvent("nikcli:mobile-overlay-open", { detail: { source: "navbar" } }));
    };

    const handleToggle = () => setMenuState(!menuOpen);
    newBtn?.addEventListener("click", handleToggle);
    cleanups.push(() => newBtn?.removeEventListener("click", handleToggle));

    const handleExternalOpen = (e: Event) => {
      if (!(e instanceof CustomEvent) || e.detail?.source === "navbar") return;
      setMenuState(false);
    };
    window.addEventListener("nikcli:mobile-overlay-open", handleExternalOpen);
    cleanups.push(() => window.removeEventListener("nikcli:mobile-overlay-open", handleExternalOpen));

    const handleEscape = (e: KeyboardEvent) => { if (e.key === "Escape") setMenuState(false); };
    window.addEventListener("keydown", handleEscape);
    cleanups.push(() => window.removeEventListener("keydown", handleEscape));

    const mq = window.matchMedia("(min-width: 768px)");
    const handleBreakpoint = (e: MediaQueryListEvent) => { if (e.matches) setMenuState(false); };
    mq.addEventListener("change", handleBreakpoint);
    cleanups.push(() => mq.removeEventListener("change", handleBreakpoint));

    const handleBeforeSwap = () => setMenuState(false);
    document.addEventListener("astro:before-swap", handleBeforeSwap);
    cleanups.push(() => document.removeEventListener("astro:before-swap", handleBeforeSwap));

    menu?.querySelectorAll("[data-mobile-menu-link]").forEach((link) => {
      const close = () => setMenuState(false);
      link.addEventListener("click", close);
      cleanups.push(() => link.removeEventListener("click", close));
    });

    win.__nikcliNavbarCleanup = () => {
      setMenuState(false);
      cleanups.forEach((fn) => fn());
    };
  };

  const win = window as Window & { __nikcliNavbarPageLoad?: () => void };
  if (win.__nikcliNavbarPageLoad) {
    document.removeEventListener("astro:page-load", win.__nikcliNavbarPageLoad);
  }
  win.__nikcliNavbarPageLoad = () => initNavbar();
  initNavbar();
  document.addEventListener("astro:page-load", win.__nikcliNavbarPageLoad);
</script>
