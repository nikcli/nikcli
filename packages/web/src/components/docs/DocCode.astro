---
/**
 * A code block with window chrome, a language badge, line numbers and copy.
 *
 * Highlighting runs at build time through Astro's bundled Shiki, in dual-theme
 * mode: each token carries a `--shiki-light` and `--shiki-dark` custom property
 * and the stylesheet picks one, so a theme switch needs no re-render and no
 * client-side highlighter ships to the browser.
 */
import { Code } from "astro:components";

interface Props {
  language?: string;
  title?: string;
}
const { language, title } = Astro.props;

function decodeHtmlEntities(value: string) {
  return value.replace(/&(#(?:x[\da-fA-F]+|\d+)|quot|apos|amp|lt|gt);/g, (entity, token: string) => {
    switch (token) {
      case "quot":
        return '"';
      case "apos":
        return "'";
      case "amp":
        return "&";
      case "lt":
        return "<";
      case "gt":
        return ">";
      default:
        if (token.startsWith("#x") || token.startsWith("#X")) {
          return String.fromCodePoint(Number.parseInt(token.slice(2), 16));
        }
        if (token.startsWith("#")) {
          return String.fromCodePoint(Number.parseInt(token.slice(1), 10));
        }
        return entity;
    }
  });
}

function normalizeCodeBlock(value: string) {
  const trimmed = decodeHtmlEntities(value).replace(/^\s*\n/, "").replace(/\n\s*$/, "");
  if (!trimmed) return "";
  const lines = trimmed.split("\n");
  const indentation = lines
    .filter((line) => line.trim().length > 0)
    .reduce((smallest, line) => {
      const leading = line.match(/^\s*/)?.[0].length ?? 0;
      return Math.min(smallest, leading);
    }, Number.POSITIVE_INFINITY);
  if (!Number.isFinite(indentation)) return trimmed;
  return lines.map((line) => line.slice(indentation)).join("\n");
}

const rawCode = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const code = normalizeCodeBlock(rawCode);
const lineCount = code.split("\n").length;
const isShell = language === "bash" || language === "sh" || language === "shell" || language === "zsh";

/**
 * Shiki throws on a language it does not know, which would fail the build for a
 * typo in one page. Anything unmapped falls back to plain text.
 */
const SHIKI_LANGS: Record<string, string> = {
  bash: "bash",
  sh: "bash",
  shell: "bash",
  zsh: "bash",
  ts: "ts",
  typescript: "ts",
  tsx: "tsx",
  js: "js",
  javascript: "js",
  json: "json",
  jsonc: "jsonc",
  yaml: "yaml",
  yml: "yaml",
  html: "html",
  css: "css",
  astro: "astro",
  powershell: "powershell",
  toml: "toml",
  diff: "diff",
  md: "markdown",
  markdown: "markdown",
};
const shikiLang = SHIKI_LANGS[(language ?? "").toLowerCase()] ?? "text";
---

<div class="doc-code-block group relative my-7 overflow-hidden rounded-[var(--radius-card)] border border-terminal-window-border bg-terminal-window-bg shadow-soft not-prose transition-[border-color,box-shadow] duration-200 ease-out hover:border-terminal-border hover:shadow-strong">

  <!-- Window chrome -->
  <div class="flex items-center justify-between gap-3 border-b border-terminal-window-border px-4 py-2.5 sm:px-5">
    <div class="flex items-center gap-3">
      <!-- Traffic lights -->
      <div class="flex gap-1.5" aria-hidden="true">
        <div class="h-2.5 w-2.5 rounded-full bg-[#FF5F56] border border-black/8 dark:border-white/8 shadow-sm"></div>
        <div class="h-2.5 w-2.5 rounded-full bg-[#FFBD2E] border border-black/8 dark:border-white/8 shadow-sm"></div>
        <div class="h-2.5 w-2.5 rounded-full bg-[#27C93F] border border-black/8 dark:border-white/8 shadow-sm"></div>
      </div>

      <!-- Title or shell indicator -->
      {title ? (
        <span class="font-mono text-[12px] font-medium text-terminal-window-muted">
          {title}
        </span>
      ) : isShell ? (
        <span class="flex items-center gap-1.5 font-mono text-[12px] font-medium text-terminal-window-muted">
          <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Terminal
        </span>
      ) : null}
    </div>

    <div class="flex items-center gap-2">
      {language && (
        <span class="rounded-md border border-terminal-window-border/80 bg-surface-active px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-terminal-window-muted">
          {language}
        </span>
      )}

      <!-- Copy button -->
      <button
        type="button"
        class="doc-copy-btn flex items-center gap-1.5 rounded-md border border-terminal-border/40 bg-surface-hover/60 px-2 py-0.5 font-mono text-[10.5px] font-medium text-terminal-muted transition-[transform,border-color,background-color,color] duration-150 ease-out hover:border-terminal-accent/40 hover:text-terminal-accent hover:bg-terminal-accent/8 active:scale-[0.97]"
        aria-label="Copy code"
        aria-live="polite"
      >
        <svg class="icon-copy w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg class="icon-ok w-3 h-3 hidden text-terminal-success" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        <span class="copy-label">Copy</span>
      </button>
    </div>
  </div>

  <!-- Code body -->
  <div class="relative flex overflow-x-auto bg-terminal-window-code">
    <!-- Line numbers (only if > 3 lines and not a shell snippet) -->
    {lineCount > 3 && !isShell && (
      <div
        class="select-none border-r border-terminal-window-border/50 bg-surface-hover/30 px-3 py-5 text-right font-mono text-[12px] leading-[1.75] text-terminal-muted/40"
        aria-hidden="true"
      >
        {Array.from({ length: lineCount }, (_, i) => (
          <div>{i + 1}</div>
        ))}
      </div>
    )}

    <!-- Code content — no radius, no border, flush background -->
    <div class="doc-code-content flex-1 overflow-x-auto p-5 text-[13px] leading-[1.75] md:text-[13.5px]">
      <Code code={code} lang={shikiLang} themes={{ light: "github-light", dark: "github-dark" }} defaultColor={false} />
    </div>
  </div>

  <!-- Shell prompt indicator strip -->
  {isShell && (
    <div class="border-t border-terminal-window-border/50 bg-surface-hover/20 px-5 py-2 flex items-center gap-2 font-mono text-[11px] text-terminal-muted/60" aria-hidden="true">
      <span class="text-terminal-accent font-bold">$</span>
      <span>shell · paste into your terminal</span>
    </div>
  )}
</div>

<style is:global>
  /* Strip all inherited prose/global styles, and Shiki's own <pre> chrome, so
     the block keeps this component's window frame instead of two frames. */
  .doc-code-block .doc-code-content pre,
  .doc-code-block .doc-code-content pre.astro-code {
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    background-color: transparent !important;
    margin: 0 !important;
    padding: 0 !important;
    box-shadow: none !important;
    overflow: visible !important;
    font-size: inherit !important;
    line-height: inherit !important;
  }

  .doc-code-block .doc-code-content code {
    display: block;
    min-width: fit-content;
    white-space: pre;
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    padding: 0 !important;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: inherit !important;
  }

  /* Dual-theme tokens: Shiki emits both colours as custom properties and the
     active theme picks one. No highlighter runs in the browser. */
  .doc-code-block .doc-code-content code,
  .doc-code-block .doc-code-content code span {
    color: var(--shiki-light);
  }

  [data-theme="dark"] .doc-code-block .doc-code-content code,
  [data-theme="dark"] .doc-code-block .doc-code-content code span {
    color: var(--shiki-dark);
  }

  /* Shiki already terminates each line with a newline character, and the block
     is `white-space: pre`. Making `.line` a block as well renders every line
     twice its height, which silently desynchronises the line-number column. */
  .doc-code-block .doc-code-content .line {
    display: inline;
  }
</style>

<script>
  const initCodeBlocks = () => {
    document.querySelectorAll<HTMLElement>(".doc-code-block").forEach((block) => {
      const btn = block.querySelector<HTMLButtonElement>(".doc-copy-btn");
      if (!btn) return;

      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      const iconCopy = newBtn.querySelector(".icon-copy") as HTMLElement | null;
      const iconOk   = newBtn.querySelector(".icon-ok") as HTMLElement | null;
      const lbl      = newBtn.querySelector(".copy-label") as HTMLElement | null;
      const codeEl   = block.querySelector<HTMLElement>(".doc-code-content code") ?? block.querySelector<HTMLElement>(".doc-code-content");

      newBtn.addEventListener("click", async () => {
        const text = codeEl?.textContent?.trim() ?? "";
        try {
          await navigator.clipboard.writeText(text);
          iconCopy?.classList.add("hidden");
          iconOk?.classList.remove("hidden");
          if (lbl) lbl.textContent = "Copied!";
          newBtn.classList.add("border-terminal-success/40", "text-terminal-success");

          setTimeout(() => {
            iconCopy?.classList.remove("hidden");
            iconOk?.classList.add("hidden");
            if (lbl) lbl.textContent = "Copy";
            newBtn.classList.remove("border-terminal-success/40", "text-terminal-success");
          }, 2000);
        } catch { /* silent */ }
      });
    });
  };

  initCodeBlocks();
  document.addEventListener("astro:page-load", initCodeBlocks);
</script>
