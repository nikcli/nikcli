---
const command = "curl -fsSL https://nikcli-ai.dev/install | bash";
---

<section
  class="page-section relative border-t border-terminal-border/50"
  id="installation"
  aria-label="Installation"
>
  <!-- Ambient glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[200px] bg-terminal-accent/6 blur-[100px] rounded-full"></div>
  </div>

  <div class="page-shell flex flex-col items-center">

    <!-- Section header -->
    <div class="mb-12 text-center max-w-xl">
      <div class="inline-flex items-center gap-2 mb-5">
        <div class="h-px w-6 bg-terminal-accent" aria-hidden="true"></div>
        <span class="font-mono text-eyebrow uppercase tracking-[0.2em] text-terminal-accent">Get started</span>
        <div class="h-px w-6 bg-terminal-accent" aria-hidden="true"></div>
      </div>
      <h2 class="font-display text-[clamp(1.75rem,4vw,3rem)] font-extrabold leading-[1.05] tracking-[-0.035em] text-terminal-text mb-3">
        Ship faster.<br/>
        <span class="text-terminal-muted font-semibold">Install in seconds.</span>
      </h2>
      <p class="text-[clamp(0.9rem,1.5vw,1rem)] font-normal text-terminal-muted leading-relaxed">
        One command to bootstrap your AI-native dev environment.
        No config required.
      </p>
    </div>

    <!-- Terminal card -->
    <div class="w-full max-w-2xl">
      <div
        class="rounded-[var(--radius-card)] border border-terminal-border/70 bg-terminal-window-bg overflow-hidden shadow-strong transition-[border-color,box-shadow] duration-200 ease-out hover:border-terminal-accent/30 hover:shadow-glow group"
      >
        <!-- Window chrome -->
        <div class="flex items-center justify-between border-b border-terminal-window-border/70 px-4 py-3 sm:px-5" aria-hidden="true">
          <div class="flex items-center gap-1.5">
            <div class="w-3 h-3 rounded-full bg-[#FF5F56] border border-black/10 dark:border-white/10 shadow-sm"></div>
            <div class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-black/10 dark:border-white/10 shadow-sm"></div>
            <div class="w-3 h-3 rounded-full bg-[#27C93F] border border-black/10 dark:border-white/10 shadow-sm"></div>
          </div>
          <span class="flex items-center gap-1.5 font-mono text-[11px] font-medium text-terminal-window-muted">
            <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Terminal
          </span>
          <!-- Copy button -->
          <button
            id="copy-install"
            type="button"
            aria-label="Copy install command"
            aria-live="polite"
            class="flex items-center gap-1.5 rounded-md border border-terminal-border/50 bg-surface-active/60 px-2.5 py-1 font-mono text-[11px] font-medium text-terminal-muted transition-transform duration-150 hover:border-terminal-accent/40 hover:text-terminal-accent hover:bg-terminal-accent/8 active:scale-[0.97]"
          >
            <svg id="copy-icon-idle" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <svg id="copy-icon-ok" class="w-3 h-3 hidden text-terminal-success" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span id="copy-label">Copy</span>
          </button>
        </div>

        <!-- Command -->
        <div class="relative bg-terminal-window-code px-5 py-5 sm:px-6 sm:py-6 font-mono">
          <div class="flex items-center gap-3 text-[14px] sm:text-[15px]">
            <span class="text-terminal-accent font-bold select-none shrink-0">$</span>
            <span class="text-terminal-window-text font-medium break-all sm:whitespace-nowrap">{command}</span>
            <span class="inline-block w-[7px] h-[14px] bg-terminal-accent/70 rounded-[1px] animate-cursor align-middle shrink-0" aria-hidden="true"></span>
          </div>
        </div>

        <!-- Simulated output -->
        <div class="border-t border-terminal-window-border/50 bg-terminal-window-code/60 px-5 py-4 sm:px-6 font-mono text-[12px] leading-[1.85] text-terminal-muted/80" aria-hidden="true">
          <div class="flex items-center gap-2.5 mb-1">
            <span class="text-terminal-success font-bold">✓</span>
            <span>Downloading nikcli <span class="text-terminal-accent">v0.0.8</span>...</span>
          </div>
          <div class="flex items-center gap-2.5 mb-1">
            <span class="text-terminal-success font-bold">✓</span>
            <span>Verifying checksum</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-terminal-success font-bold">✓</span>
            <span>Installed to <span class="text-terminal-text">/usr/local/bin/nikcli</span></span>
          </div>
          <div class="mt-2 flex items-center gap-2.5">
            <span class="text-terminal-accent font-bold">→</span>
            <span class="text-terminal-text font-semibold">Run <code class="text-terminal-accent bg-terminal-accent/10 px-1.5 py-0.5 rounded text-[11px] border border-terminal-accent/20">nikcli</code> to get started</span>
          </div>
        </div>

        <!-- Status bar -->
        <div class="border-t border-terminal-window-border/50 bg-surface-hover/30 px-5 py-2 flex items-center justify-between text-[11px] font-mono text-terminal-muted/60" aria-hidden="true">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-terminal-success inline-block"></span>
            Ready · macOS / Linux
          </span>
          <span>MIT License</span>
        </div>
      </div>
    </div>

    <!-- Footnote -->
    <div class="mt-6 flex flex-col sm:flex-row items-center gap-4 sm:gap-8 text-[12.5px] text-terminal-muted/70">
      <span>Requires Node.js 18+</span>
      <span class="hidden sm:block w-px h-4 bg-terminal-border/60" aria-hidden="true"></span>
      <a
        href="/docs#install-run"
        class="font-medium text-terminal-muted underline underline-offset-4 decoration-terminal-border/60 hover:text-terminal-text hover:decoration-terminal-accent transition-colors duration-100 ease-out"
      >
        Manual install & Windows guide →
      </a>
    </div>

  </div>
</section>

<style>
  /* Strip any inherited borders/radius from code elements inside the block */
  #installation code,
  #installation pre {
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
  }
</style>

<script>
  const initCopy = () => {
    const btn = document.getElementById("copy-install");
    if (!btn) return;

    const newBtn = btn.cloneNode(true) as HTMLElement;
    btn.parentNode?.replaceChild(newBtn, btn);

    const iconIdle = newBtn.querySelector("#copy-icon-idle") as HTMLElement | null;
    const iconOk   = newBtn.querySelector("#copy-icon-ok") as HTMLElement | null;
    const lbl      = newBtn.querySelector("#copy-label") as HTMLElement | null;

    const cmd = "curl -fsSL https://nikcli-ai.dev/install | bash";

    newBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cmd);
        iconIdle?.classList.add("hidden");
        iconOk?.classList.remove("hidden");
        if (lbl) lbl.textContent = "Copied!";
        newBtn.classList.add("border-terminal-success/50", "text-terminal-success");

        window.posthog?.capture("install_command_copied");

        setTimeout(() => {
          iconIdle?.classList.remove("hidden");
          iconOk?.classList.add("hidden");
          if (lbl) lbl.textContent = "Copy";
          newBtn.classList.remove("border-terminal-success/50", "text-terminal-success");
        }, 2200);
      } catch { /* silent */ }
    });
  };

  initCopy();
  document.addEventListener("astro:page-load", initCopy);
</script>
