{
  "name": "@nikcli-ai/web",
  "version": "1.393.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "echo '_worker.js' > dist/.assetsignore && wrangler deploy",
    "check": "bun run check:docs-index && bun run check:docs-anchors && bun run check:api-groups && bun run check:docs-tools",
    "check:docs-tools": "bun run script/check-docs-tool-index.ts",
    "check:docs-index": "bun run script/check-docs-index.ts",
    "check:api-groups": "bun run script/check-api-groups.ts",
    "check:docs-anchors": "bun run script/check-docs-anchors.ts",
    "build:brandkit": "bun run script/build-brandkit.ts",
    "build:social-image": "bun run script/build-social-image.ts",
    "test:social-meta": "bun run build && bun test script/social-meta.test.ts",
    "build:world-map": "bun run script/build-world-map.ts",
    "d1:migrate:local": "wrangler d1 migrations apply nikcli-web --local",
    "d1:migrate:remote": "wrangler d1 migrations apply nikcli-web --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/mdx": "^4.0.2",
    "@astrojs/react": "^4.4.0",
    "@astrojs/tailwind": "^5.1.3",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/space-grotesk": "^5.1.1",
    "@mixmark-io/domino": "^2.2.0",
    "@nikcli-ai/auth": "workspace:*",
    "@nikcli-ai/sdk": "workspace:*",
    "@nikcli-ai/util": "workspace:*",
    "@tailwindcss/typography": "0.5.19",
    "@types/bcryptjs": "3.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "astro": "^5.1.1",
    "bcryptjs": "3.0.3",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "react-router-dom": "7.14.0",
    "tailwindcss": "^3.4.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260621.1",
    "@types/node": "catalog:",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "wrangler": "4.103.0"
  }
}
