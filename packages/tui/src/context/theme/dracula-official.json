{
  "$schema": "https://nikcli-ai.dev/theme.json",
  "defs": {
    "bg": "#282a36",
    "bgAlt": "#21222c",
    "fg": "#f8f8f2",
    "fgAlt": "#6272a4",
    "selection": "#44475a",
    "comment": "#6272a4",
    "cyan": "#8be9fd",
