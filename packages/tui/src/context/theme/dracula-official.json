    "orange": "#ffb86c",
    "pink": "#ff79c6",
    "purple": "#bd93f9",
    "red": "#ff5555",
    "yellow": "#f1fa8c",
    "bgInactive": "#3a3d52",
    "bgVisual": "#3a3d52"
